@page
@model LockoutModel

@{
    ViewData["Title"] = "Account bloccato";
}

<section class="auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <div class="auth-card">

                    <div class="gallery-eyebrow mb-3">
                        Accesso
                    </div>

                    <h1 class="auth-title">
                        Account temporaneamente bloccato
                    </h1>

                    <p class="auth-subtitle">
                        Ci sono stati troppi tentativi di accesso non riusciti. Riprova tra qualche minuto.
                    </p>

                    <div class="text-center mt-4">
                        <a asp-page="./Login" class="auth-link">Torna all'accesso</a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
