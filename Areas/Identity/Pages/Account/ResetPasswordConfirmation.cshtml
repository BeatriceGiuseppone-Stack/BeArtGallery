@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Password reimpostata";
}

<section class="auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <div class="auth-card">

                    <div class="gallery-eyebrow mb-3">
                        Recupero password
                    </div>

                    <h1 class="auth-title">
                        Password reimpostata
                    </h1>

                    <p class="auth-subtitle">
                        La nuova password è attiva: ora puoi accedere al tuo account.
                    </p>

                    <a asp-page="./Login"
                       class="btn gallery-btn-primary w-100">
                        Accedi
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>
