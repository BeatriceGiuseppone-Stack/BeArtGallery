@page
@model RegisterModel

@{
    ViewData["Title"] = "Registrati";
}

<section class="auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <div class="auth-card">

                    <div class="gallery-eyebrow mb-3">
                        BeArtGallery
                    </div>

                    <h1 class="auth-title">
                        Crea il tuo account
                    </h1>

                    <p class="auth-subtitle">
                        Registrati per prenotare gli eventi
                        e gestire le tue partecipazioni.
                    </p>


                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4"
                             role="alert">
                        </div>


                        <div class="mb-4">

                            <label asp-for="Input.Email"
                                   class="form-label gallery-form-label">

                                Email

                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control gallery-form-control"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="nome@email.it" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Input.Password"
                                   class="form-label gallery-form-label">

                                Password

                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control gallery-form-control"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Inserisci una password" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label gallery-form-label">

                                Conferma password

                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control gallery-form-control"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Ripeti la password" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>


                        <button id="registerSubmit"
                                type="submit"
                                class="btn gallery-btn-primary w-100">

                            Crea account

                        </button>


                        <div class="auth-divider">

                            <span>
                                oppure
                            </span>

                        </div>


                        <div class="text-center">

                            <p class="mb-2 text-muted">
                                Hai già un account?
                            </p>

                            <a asp-page="./Login"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="auth-register-link">

                                Accedi

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}