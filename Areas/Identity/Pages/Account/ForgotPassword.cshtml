@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Password dimenticata";
}

<section class="auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <div class="auth-card">

                    <div class="gallery-eyebrow mb-3">
                        Recupero password
                    </div>

                    <h1 class="auth-title">
                        Password dimenticata?
                    </h1>

                    <p class="auth-subtitle">
                        Inserisci l'email del tuo account: ti invieremo un link per sceglierne una nuova.
                    </p>

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4"
                             role="alert">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Input.Email"
                                   class="form-label gallery-form-label">
                                Email
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control gallery-form-control"
                                   autocomplete="username"
                                   aria-required="true" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn gallery-btn-primary w-100">
                            Invia il link
                        </button>

                    </form>

                    <div class="text-center mt-4">
                        <a asp-page="./Login" class="auth-link">Torna all'accesso</a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
