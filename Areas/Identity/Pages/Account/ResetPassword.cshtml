@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reimposta password";
}

<section class="auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <div class="auth-card">

                    <div class="gallery-eyebrow mb-3">
                        Recupero password
                    </div>

                    <h1 class="auth-title">
                        Scegli una nuova password
                    </h1>

                    <p class="auth-subtitle">
                        La password deve avere almeno 6 caratteri.
                    </p>

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4"
                             role="alert">
                        </div>

                        <input asp-for="Input.Code" type="hidden" />

                        <div class="mb-4">

                            <label asp-for="Input.Email"
                                   class="form-label gallery-form-label">
                                Email
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control gallery-form-control"
                                   autocomplete="username"
                                   aria-required="true" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Input.Password"
                                   class="form-label gallery-form-label">
                                Nuova password
                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control gallery-form-control"
                                   autocomplete="new-password"
                                   aria-required="true" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label gallery-form-label">
                                Conferma password
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control gallery-form-control"
                                   autocomplete="new-password"
                                   aria-required="true" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn gallery-btn-primary w-100">
                            Reimposta password
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
