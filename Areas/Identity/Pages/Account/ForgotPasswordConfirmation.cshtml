@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Controlla la tua email";
}

<section class="auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <div class="auth-card">

                    <div class="gallery-eyebrow mb-3">
                        Recupero password
                    </div>

                    <h1 class="auth-title">
                        Controlla la tua email
                    </h1>

                    <p class="auth-subtitle">
                        Se l'indirizzo è registrato, riceverai un messaggio con il link per reimpostare la password.
                    </p>

                    <div class="text-center mt-4">
                        <a asp-page="./Login" class="auth-link">Torna all'accesso</a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
