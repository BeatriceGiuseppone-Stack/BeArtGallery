@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Cambia password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="account-content">

    <partial name="_StatusMessage"
             for="StatusMessage" />

    <div class="gallery-eyebrow mb-2">
        Password
    </div>

    <h2 class="account-section-title">
        Cambia password
    </h2>

    <p class="account-section-intro">
        Per sicurezza inserisci prima la password attuale.
        La nuova password deve avere almeno 6 caratteri.
    </p>

    <form id="change-password-form"
          method="post"
          style="max-width: 32rem;">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-4"
             role="alert">
        </div>

        <div class="mb-4">

            <label asp-for="Input.OldPassword"
                   class="form-label gallery-form-label">
                Password attuale
            </label>

            <input asp-for="Input.OldPassword"
                   class="form-control gallery-form-control"
                   autocomplete="current-password"
                   aria-required="true" />

            <span asp-validation-for="Input.OldPassword"
                  class="text-danger small">
            </span>

        </div>

        <div class="mb-4">

            <label asp-for="Input.NewPassword"
                   class="form-label gallery-form-label">
                Nuova password
            </label>

            <input asp-for="Input.NewPassword"
                   class="form-control gallery-form-control"
                   autocomplete="new-password"
                   aria-required="true" />

            <span asp-validation-for="Input.NewPassword"
                  class="text-danger small">
            </span>

        </div>

        <div class="mb-4">

            <label asp-for="Input.ConfirmPassword"
                   class="form-label gallery-form-label">
                Conferma nuova password
            </label>

            <input asp-for="Input.ConfirmPassword"
                   class="form-control gallery-form-control"
                   autocomplete="new-password"
                   aria-required="true" />

            <span asp-validation-for="Input.ConfirmPassword"
                  class="text-danger small">
            </span>

        </div>

        <button type="submit"
                class="btn gallery-btn-primary">
            Aggiorna password
        </button>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
