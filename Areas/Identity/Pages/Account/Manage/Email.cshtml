@page
@model EmailModel

@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="account-content">

    <partial name="_StatusMessage"
             for="StatusMessage" />

    <div class="gallery-eyebrow mb-2">
        Email
    </div>

    <h2 class="account-section-title">
        Indirizzo email
    </h2>

    <p class="account-section-intro">
        È l'indirizzo che usi per accedere e su cui ricevi
        le comunicazioni della galleria.
    </p>

    <form id="email-form"
          method="post"
          style="max-width: 32rem;">

        <div asp-validation-summary="All"
             class="text-danger mb-4"
             role="alert">
        </div>

        <div class="mb-4">

            <label asp-for="Email"
                   class="form-label gallery-form-label">
                Email attuale
            </label>

            <input asp-for="Email"
                   class="form-control gallery-form-control"
                   disabled />

            @if (Model.IsEmailConfirmed)
            {
                <div class="form-text">
                    Indirizzo confermato.
                </div>
            }
            else
            {
                <button id="email-verification"
                        type="submit"
                        asp-page-handler="SendVerificationEmail"
                        class="btn btn-link p-0 mt-2">
                    Invia di nuovo l'email di verifica
                </button>
            }

        </div>

        <div class="mb-4">

            <label asp-for="Input.NewEmail"
                   class="form-label gallery-form-label">
                Nuova email
            </label>

            <input asp-for="Input.NewEmail"
                   class="form-control gallery-form-control"
                   autocomplete="email"
                   aria-required="true"
                   placeholder="nome@email.it" />

            <span asp-validation-for="Input.NewEmail"
                  class="text-danger small">
            </span>

        </div>

        <button id="change-email-button"
                type="submit"
                asp-page-handler="ChangeEmail"
                class="btn gallery-btn-primary">
            Cambia email
        </button>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
