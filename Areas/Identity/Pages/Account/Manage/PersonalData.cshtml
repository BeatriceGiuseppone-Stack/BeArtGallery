@page
@model PersonalDataModel

@{
    ViewData["Title"] = "Dati personali";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="account-content">

    <div class="gallery-eyebrow mb-2">
        Dati personali
    </div>

    <h2 class="account-section-title">
        I tuoi dati
    </h2>

    <p class="account-section-intro">
        Il tuo account contiene i dati che ci hai fornito.
        Da qui puoi scaricarli oppure eliminare l'account.
    </p>

    <div class="gx-notice gx-notice-warn mb-4" style="max-width: 36rem;">
        <strong>L'eliminazione è definitiva.</strong>
        <span>Account, prenotazioni e preferenze non potranno essere recuperati.</span>
    </div>

    <div class="d-flex flex-wrap gap-2">

        <form id="download-data"
              asp-page="DownloadPersonalData"
              method="post">

            <button class="btn gallery-btn-outline"
                    type="submit">
                Scarica i miei dati
            </button>

        </form>

        <a id="delete"
           asp-page="DeletePersonalData"
           class="btn gallery-btn-danger">
            Elimina account
        </a>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
