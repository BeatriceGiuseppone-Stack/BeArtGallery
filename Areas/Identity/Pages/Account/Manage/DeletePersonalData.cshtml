@page
@model DeletePersonalDataModel

@{
    ViewData["Title"] = "Elimina account";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="account-content">

    <div class="gallery-eyebrow mb-2">
        Dati personali
    </div>

    <h2 class="account-section-title">
        Eliminare il tuo account?
    </h2>

    <div class="gx-notice gx-notice-alert mb-4" style="max-width: 36rem;">
        <strong>L'operazione non si può annullare.</strong>
        <span>Il tuo account e i dati collegati verranno rimossi definitivamente.</span>
    </div>

    <form id="delete-user"
          method="post"
          style="max-width: 32rem;">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-4"
             role="alert">
        </div>

        @if (Model.RequirePassword)
        {
            <div class="mb-4">

                <label asp-for="Input.Password"
                       class="form-label gallery-form-label">
                    Password
                </label>

                <input asp-for="Input.Password"
                       class="form-control gallery-form-control"
                       autocomplete="current-password"
                       aria-required="true" />

                <span asp-validation-for="Input.Password"
                      class="text-danger small">
                </span>

            </div>
        }

        <div class="d-flex flex-wrap gap-2">

            <button class="btn gallery-btn-danger"
                    type="submit">
                Elimina dati e chiudi l'account
            </button>

            <a asp-page="./PersonalData"
               class="btn gallery-btn-outline">
                Annulla
            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
