@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel

@{
    ViewData["Title"] = "Sicurezza";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="account-content">

    <partial name="_StatusMessage"
             for="StatusMessage" />

    <div class="gallery-eyebrow mb-2">
        Sicurezza
    </div>

    <h2 class="account-section-title">
        Verifica in due passaggi
    </h2>

    <p class="account-section-intro">
        Oltre alla password puoi richiedere un codice generato da un'app
        di autenticazione sul telefono.
    </p>

    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();

        @if (consentFeature?.CanTrack ?? true)
        {
            @if (Model.Is2faEnabled)
            {
                if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="gx-notice gx-notice-alert mb-4">
                        <strong>Non hai più codici di recupero.</strong>
                        <span>
                            Devi <a asp-page="./GenerateRecoveryCodes">generare nuovi codici</a>
                            prima di poter accedere con un codice di recupero.
                        </span>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="gx-notice gx-notice-alert mb-4">
                        <strong>Ti resta un solo codice di recupero.</strong>
                        <span>Puoi <a asp-page="./GenerateRecoveryCodes">generare nuovi codici</a>.</span>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="gx-notice gx-notice-warn mb-4">
                        <strong>Ti restano @Model.RecoveryCodesLeft codici di recupero.</strong>
                        <span>Ti consigliamo di <a asp-page="./GenerateRecoveryCodes">generarne di nuovi</a>.</span>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 mb-4">

                    @if (Model.IsMachineRemembered)
                    {
                        <form method="post">
                            <button type="submit"
                                    class="btn gallery-btn-outline">
                                Dimentica questo browser
                            </button>
                        </form>
                    }

                    <a asp-page="./Disable2fa"
                       class="btn gallery-btn-outline">
                        Disattiva la verifica
                    </a>

                    <a asp-page="./GenerateRecoveryCodes"
                       class="btn gallery-btn-outline">
                        Nuovi codici di recupero
                    </a>

                </div>
            }

            <h3 class="account-section-title" style="font-size: 1.4rem;">
                App di autenticazione
            </h3>

            <div class="d-flex flex-wrap gap-2">

                @if (!Model.HasAuthenticator)
                {
                    <a id="enable-authenticator"
                       asp-page="./EnableAuthenticator"
                       class="btn gallery-btn-primary">
                        Aggiungi un'app di autenticazione
                    </a>
                }
                else
                {
                    <a id="enable-authenticator"
                       asp-page="./EnableAuthenticator"
                       class="btn gallery-btn-primary">
                        Configura l'app
                    </a>

                    <a id="reset-authenticator"
                       asp-page="./ResetAuthenticator"
                       class="btn gallery-btn-outline">
                        Reimposta l'app
                    </a>
                }

            </div>
        }
        else
        {
            <div class="gx-notice gx-notice-alert">
                <strong>Informativa privacy e cookie non accettata.</strong>
                <span>Devi accettarla prima di attivare la verifica in due passaggi.</span>
            </div>
        }
    }

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
