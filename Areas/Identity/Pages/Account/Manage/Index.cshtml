@page
@model IndexModel

@{
    ViewData["Title"] = "Il mio profilo";
    ViewData["ActivePage"] = ManageNavPages.Index;
}


<div class="account-content">

    <partial name="_StatusMessage"
             for="StatusMessage" />


    <div class="gallery-eyebrow mb-2">
        Profilo
    </div>

    <h2 class="account-section-title">
        Informazioni account
    </h2>

    <p class="account-section-intro">
        Puoi aggiornare le informazioni
        associate al tuo profilo.
    </p>


    <form id="profile-form"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-4"
             role="alert">
        </div>


        <div class="mb-4">

            <label asp-for="Username"
                   class="form-label gallery-form-label">

                Email account

            </label>

            <input asp-for="Username"
                   class="form-control gallery-form-control"
                   disabled />

            <div class="form-text">

                L'email principale viene gestita
                dalla sezione Email.

            </div>

        </div>


        <div class="mb-4">

            <label asp-for="Input.PhoneNumber"
                   class="form-label gallery-form-label">

                Numero di telefono

            </label>

            <input asp-for="Input.PhoneNumber"
                   class="form-control gallery-form-control"
                   placeholder="Inserisci il numero di telefono" />

            <span asp-validation-for="Input.PhoneNumber"
                  class="text-danger small">
            </span>

        </div>


        <button id="update-profile-button"
                type="submit"
                class="btn gallery-btn-primary">

            Salva modifiche

        </button>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}