@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) &&
        parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="container py-5">

    <div class="account-header">

        <div class="gallery-eyebrow mb-3">
            Il tuo account
        </div>

        <h1 class="account-page-title">
            Gestisci il tuo profilo
        </h1>

        <p class="account-page-intro">
            Consulta e aggiorna le informazioni
            e le impostazioni associate al tuo account BeArtGallery.
        </p>

    </div>


    <div class="row g-5">

        <div class="col-lg-3">

            <partial name="_ManageNav" />

        </div>


        <div class="col-lg-9">

            @RenderBody()

        </div>

    </div>

</div>


@section Scripts {

    @RenderSection(
        "Scripts",
        required: false)

}