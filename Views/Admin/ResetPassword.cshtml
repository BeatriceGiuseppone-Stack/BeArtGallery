@model BeArtGallery.ViewModels.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Reimposta password";
}

<div class="container py-5 gx-manage">

    <a asp-action="Users" class="gx-back-link"> 
        ← Torna alla gestione utenti
    </a>

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="gx-form-card">

                <div>

                    <div class="gallery-eyebrow mb-2">
                        Area amministrazione
                    </div>

                    <h1 class="gx-form-title">
                        Reimposta password
                    </h1>

                    <p class="gx-page-intro mb-4">
                        Imposta una nuova password per l'utente selezionato.
                    </p>

                    @* Utente a cui si cambia la password *@
                    <div class="gx-notice mb-4">
                        <span class="gx-notice-meta">Utente</span>
                        @Model.Email
                    </div>

                    @* Form per la nuova password *@
                    <form asp-action="ResetPassword" method="post">

                        @* Id dell'utente (nascosto) *@
                        <input asp-for="UserId" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="NewPassword" class="form-label">
                            </label>

                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />

                            <span asp-validation-for="NewPassword" class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword" class="form-label">
                            </label>

                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword" class="text-danger">
                            </span>

                        </div>

                        @* Avviso: la vecchia password non si può vedere e verrà sostituita *@
                        <div class="gx-notice gx-notice-warn mb-4">
                            L'amministratore non può visualizzare la password
                            precedente. Questa operazione la sostituirà con
                            quella appena inserita.
                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit" class="btn gallery-btn-primary">
                                Reimposta password
                            </button>

                            <a asp-action="Users" class="btn gallery-btn-outline">
                                Annulla
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@* Script per controllare il form prima dell'invio *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}