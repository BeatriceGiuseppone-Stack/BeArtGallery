@model BeArtGallery.ViewModels.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Reimposta password";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-action="Users"
           class="text-decoration-none text-dark">
            ← Torna alla gestione utenti
        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h1 class="h3 mb-2">
                        Reimposta password
                    </h1>

                    <p class="text-muted mb-4">
                        Imposta una nuova password per l'utente selezionato.
                    </p>

                    <div class="alert alert-light border mb-4">
                        <strong>Utente:</strong>
                        @Model.Email
                    </div>

                    <form asp-action="ResetPassword"
                          method="post">

                        <input asp-for="UserId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label">
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-warning">
                            L'amministratore non può visualizzare la password
                            precedente. Questa operazione la sostituirà con
                            quella appena inserita.
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-dark">
                                Reimposta password
                            </button>

                            <a asp-action="Users"
                               class="btn btn-outline-secondary">
                                Annulla
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}