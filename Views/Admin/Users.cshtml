@model IEnumerable<BeArtGallery.ViewModels.UserManagementViewModel>
@using BeArtGallery.Authorization

@{
    ViewData["Title"] = "Gestione utenti";

    var total = Model.Count();
    var adminCount = Model.Count(u => u.Role == RoleNames.Admin);
    var staffCount = Model.Count(u => u.Role == RoleNames.Staff);
    var visitorCount = total - adminCount - staffCount;
}

<div class="container py-5 gx-manage">

    @* Intestazione *@

    <div class="gx-page-head">

        <div>

            <div class="gallery-eyebrow mb-2">
                Area amministrazione
            </div>

            <h1 class="gx-page-title">
                Gestione utenti
            </h1>

            <p class="gx-page-intro">
                Visualizza gli utenti registrati, gestisci i ruoli
                e reimposta le password.
            </p>

        </div>

        <div class="gx-page-actions">

            <a asp-controller="Admin"
               asp-action="CreateUser"
               class="btn gallery-btn-primary">
                Nuovo utente
            </a>

        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="gx-empty">

            <h2>
                Nessun utente registrato
            </h2>

            <p>
                Crea il primo account per lo staff o per un visitatore.
            </p>

            <a asp-controller="Admin"
               asp-action="CreateUser"
               class="btn gallery-btn-primary">
                Nuovo utente
            </a>

        </div>
    }
    else
    {
        @* Riepilogo dei ruoli *@

        <p class="gx-roster-summary">
            @total @(total == 1 ? "utente" : "utenti"):
            <span>@adminCount Admin</span>
            <span>@staffCount Staff</span>
            <span>@visitorCount @(visitorCount == 1 ? "visitatore" : "visitatori")</span>
        </p>

        <ul class="gx-roster">

            @foreach (var user in Model)
            {
                var initial = string.IsNullOrEmpty(user.Email)
                    ? "?"
                    : user.Email.Substring(0, 1).ToUpperInvariant();

                <li class="gx-roster-row">

                    @* Utente *@

                    <div class="gx-roster-user">

                        <span class="gx-monogram" aria-hidden="true">@initial</span>

                        <div>

                            <div class="gx-roster-email">
                                @user.Email
                            </div>

                            @if (user.Role == RoleNames.Admin)
                            {
                                <span class="gx-tag">Admin</span>
                            }
                            else if (user.Role == RoleNames.Staff)
                            {
                                <span class="gx-tag gx-tag-ok">Staff</span>
                            }
                            else
                            {
                                <span class="gx-tag gx-tag-muted">Visitatore</span>
                            }

                        </div>

                    </div>


                    @* Modifica ruolo *@

                    <form asp-controller="Admin"
                          asp-action="ChangeRole"
                          method="post"
                          class="gx-roster-role">

                        <input type="hidden"
                               name="userId"
                               value="@user.Id" />

                        <label class="visually-hidden"
                               for="role-@user.Id">
                            Ruolo di @user.Email
                        </label>

                        <select name="role"
                                id="role-@user.Id"
                                class="form-select">

                            @if (user.Role == RoleNames.Visitore)
                            {
                                <option value="@RoleNames.Visitore" selected>Visitatore</option>
                            }
                            else
                            {
                                <option value="@RoleNames.Visitore">Visitatore</option>
                            }

                            @if (user.Role == RoleNames.Staff)
                            {
                                <option value="@RoleNames.Staff" selected>Staff</option>
                            }
                            else
                            {
                                <option value="@RoleNames.Staff">Staff</option>
                            }

                            @if (user.Role == RoleNames.Admin)
                            {
                                <option value="@RoleNames.Admin" selected>Admin</option>
                            }
                            else
                            {
                                <option value="@RoleNames.Admin">Admin</option>
                            }

                        </select>

                        <button type="submit"
                                class="btn gallery-btn-outline">
                            Aggiorna ruolo
                        </button>

                    </form>


                    @* Reimposta password *@

                    <div class="gx-roster-actions">

                        <a asp-controller="Admin"
                           asp-action="ResetPassword"
                           asp-route-userId="@user.Id">
                            Reimposta password
                        </a>

                    </div>

                </li>
            }

        </ul>
    }

</div>
