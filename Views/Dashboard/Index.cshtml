@model BeArtGallery.ViewModels.DashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
}


@* Stili della dashboard *@
@section Styles
{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@* Dashboard per Staff e Admin: numeri, presenze, feedback, grafici e classifiche *@
<div class="dashboard-page">

    <div class="container">

        @* Intestazione con la data di aggiornamento *@

        <header class="dashboard-header">

            <div>

                <div class="gallery-eyebrow">
                    BeArtGallery Management
                </div>

                <h1>
                    Dashboard
                </h1>

                <p>
                    Una panoramica sulle attività della galleria,
                    sull'interesse dei visitatori e sulle prenotazioni.
                </p>

            </div>

        </header>
         
        @* Numeri principali (KPI) *@

        <section class="dashboard-kpis">

            <div class="dashboard-kpi">

                <span>
                    Utenti registrati
                </span>

                <strong>
                    @Model.TotalUsers
                </strong>

                <small>
                    Account presenti sulla piattaforma
                </small>

            </div>

            <div class="dashboard-kpi">

                <span>
                    Opere
                </span>

                <strong>
                    @Model.TotalArtworks
                </strong>

                <small>
                    @Model.AvailableArtworks disponibili
                </small>

            </div>

            <div class="dashboard-kpi">

                <span>
                    Preferiti
                </span>

                <strong>
                    @Model.TotalFavorites
                </strong>

                <small>
                    Salvataggi complessivi
                </small>

            </div>

            <div class="dashboard-kpi">

                <span>
                    Richieste aperte
                </span>

                <strong>
                    @Model.OpenInquiries
                </strong>

                <small>
                    @Model.TotalInquiries totali
                </small>

            </div>

            <div class="dashboard-kpi">

                <span>
                    Prenotazioni
                </span>

                <strong>
                    @Model.ConfirmedBookings
                </strong>

                <small>
                    Prenotazioni confermate
                </small>

            </div>

            @* Percentuali in evidenza *@
            <div class="dashboard-kpi dashboard-kpi-highlight">

                <span>
                    Occupazione
                </span>

                <strong>
                    @Model.OccupancyRate%
                </strong>

                <small>
                    Posti occupati nelle prossime attività
                </small>

            </div>

            <div class="dashboard-kpi">

                <span>
                    Visualizzazioni opere
                </span>

                <strong>
                    @Model.TotalArtworkViews
                </strong>

                <small>
                    Visualizzazioni registrate nel catalogo
                </small>

            </div>

            <div class="dashboard-kpi">

                <span>
                    Vista → Preferito
                </span>

                <strong>
                    @Model.ViewToFavoriteRate%
                </strong>

                <small>
                    Rapporto tra visualizzazioni e preferiti
                </small>

            </div>

            <div class="dashboard-kpi dashboard-kpi-highlight">

                <span>
                    Preferito → Richiesta
                </span>

                <strong>
                    @Model.FavoriteToInquiryRate%
                </strong>

                <small>
                    Rapporto tra preferiti e richieste
                </small>

            </div>

        </section>

        @* Presenze e check-in *@

        <section class="dashboard-attendance-section">

            <div class="dashboard-section-heading">

                <div>

                    <span class="gallery-eyebrow">
                        Accessi in galleria
                    </span>

                    <h2>
                        Presenze e check-in
                    </h2>

                </div>

                <p>
                    Analisi degli ingressi registrati tramite
                    i QR code delle prenotazioni.
                </p>

            </div>

            <div class="dashboard-attendance-grid">

                @* Visitatori attesi *@

                <article class="dashboard-attendance-card">

                    <span class="dashboard-attendance-label">
                        Visitatori attesi
                    </span>

                    <strong class="dashboard-attendance-value">

                        @Model.ExpectedVisitors

                    </strong>

                    <small>

                        Persone associate alle
                        prenotazioni confermate

                    </small>

                </article>

                @* Persone entrate *@

                <article class="dashboard-attendance-card dashboard-attendance-card-success">

                    <span class="dashboard-attendance-label">
                        Ingressi registrati
                    </span>

                    <strong class="dashboard-attendance-value">

                        @Model.CheckedInVisitors

                    </strong>

                    <small>

                        Visitatori che hanno effettuato
                        il check-in

                    </small>

                </article>

                @* Persone ancora da arrivare *@

                <article class="dashboard-attendance-card">

                    <span class="dashboard-attendance-label">
                        Da arrivare
                    </span>

                    <strong class="dashboard-attendance-value">

                        @Model.VisitorsToArrive

                    </strong>

                    <small>

                        Visitatori attesi per
                        attività non ancora concluse

                    </small>

                </article>

                @* No-show: prenotati che non si sono presentati *@

                <article class="dashboard-attendance-card dashboard-attendance-card-warning">

                    <span class="dashboard-attendance-label">
                        No-show
                    </span>

                    <strong class="dashboard-attendance-value">

                        @Model.NoShowVisitors

                    </strong>

                    <small>

                        Visitatori non presentati
                        ad attività concluse

                    </small>

                </article>

                @* Tasso di presenza (solo attività finite) *@

                <article class="dashboard-attendance-card dashboard-attendance-card-highlight">

                    <span class="dashboard-attendance-label">
                        Tasso di presenza
                    </span>

                    <div class="dashboard-attendance-rate">

                        <strong class="dashboard-attendance-value">

                            @Model.AttendanceRate%

                        </strong>

                        <div class="dashboard-attendance-progress">

                            <span style="width:
                                @($"{Math.Min(Model.AttendanceRate, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%")">
                            </span>

                        </div>

                    </div>

                    <small>

                        Rapporto tra visitatori attesi
                        e ingressi nelle attività concluse

                    </small>

                </article>

            </div>

        </section>

        @* Soddisfazione dei visitatori (feedback) *@

        <section class="dashboard-attendance-section">

            <div class="dashboard-section-heading">

                <div>

                    <span class="gallery-eyebrow">
                        Esperienza dei visitatori
                    </span>

                    <h2>
                        Soddisfazione dei visitatori
                    </h2>

                </div>


                <p>
                    Valutazioni lasciate dai visitatori dopo
                    il check-in agli eventi.
                    <a asp-controller="Feedback" asp-action="Index">
                        Vedi tutti i feedback
                    </a>
                </p>

            </div>

            <div class="dashboard-attendance-grid">

                <article class="dashboard-attendance-card dashboard-attendance-card-highlight">

                    <span class="dashboard-attendance-label">
                        Valutazione media
                    </span>

                    <strong class="dashboard-attendance-value">

                        @(Model.TotalFeedbacks > 0 ? Model.AverageRating.ToString("0.0") + "/5" : "—")

                    </strong>

                    <small>
                        Media dei voti da 1 a 5 stelle
                    </small>

                </article>


                <article class="dashboard-attendance-card">

                    <span class="dashboard-attendance-label">
                        Feedback ricevuti
                    </span>

                    <strong class="dashboard-attendance-value">

                        @Model.TotalFeedbacks

                    </strong>

                    <small>
                        Un feedback per prenotazione
                    </small>

                </article>

                @* Ultimi due commenti *@
                @foreach (var feedback in Model.LatestFeedbacks.Take(2))
                {
                    <article class="dashboard-attendance-card">

                        <span class="dashboard-attendance-label">
                            @feedback.ActivityTitle
                        </span>

                        <strong class="dashboard-attendance-value">

                            @(new string('★', feedback.Rating))

                        </strong>

                        <small>

                            @(string.IsNullOrWhiteSpace(feedback.Comment) ? "Nessun commento"
                                : feedback.Comment.Length > 90 ? feedback.Comment.Substring(0, 90) + "…"
                                    : feedback.Comment)

                        </small>

                    </article>
                }

            </div>

        </section>

        @* Grafici: prenotazioni per mese e richieste per stato *@

        <section class="dashboard-grid dashboard-chart-grid">

            <article class="dashboard-panel dashboard-panel-large">

                <div class="dashboard-panel-header">

                    <div>

                        <span class="gallery-eyebrow">
                            Andamento
                        </span>

                        <h2>
                            Prenotazioni
                        </h2>

                    </div>

                    <span class="dashboard-panel-note">
                        Ultimi 6 mesi
                    </span>

                </div>


                <div class="dashboard-chart-container">

                    @* Grafico disegnato da dashboard.js con Chart.js *@
                    <canvas id="bookingsChart">
                    </canvas>

                </div>

            </article>

            <article class="dashboard-panel">

                <div class="dashboard-panel-header">

                    <div>

                        <span class="gallery-eyebrow">
                            Contatti
                        </span>

                        <h2>
                            Richieste informazioni
                        </h2>

                    </div>

                </div>

                <div class="dashboard-chart-container dashboard-chart-small">

                    <canvas id="inquiriesChart">
                    </canvas>

                </div>

                @* Legenda del grafico delle richieste *@
                <div class="dashboard-chart-legend">

                    <div>
                        <span>
                            Nuove
                        </span>

                        <strong>
                            @Model.NewInquiries
                        </strong>
                    </div>

                    <div>
                        <span>
                            In lavorazione
                        </span>

                        <strong>
                            @Model.InProgressInquiries
                        </strong>
                    </div>

                    <div>
                        <span>
                            Chiuse
                        </span>

                        <strong>
                            @Model.ClosedInquiries
                        </strong>
                    </div>

                </div>

            </article>

        </section>

        @* Classifiche delle opere *@

        <section class="dashboard-grid dashboard-artworks-grid">

            @* Opere più viste *@

            <article class="dashboard-panel">

                <div class="dashboard-panel-header">

                    <div>

                        <span class="gallery-eyebrow">
                            Visibilità
                        </span>

                        <h2>
                            Opere più visualizzate
                        </h2>

                    </div>

                </div>


                @if (Model.MostViewedArtworks.Any())
                {
                    <div class="dashboard-ranking">

                        @* Posizione in classifica *@
                        @{
                            var position = 1;
                        }

                        @foreach (var artwork in Model.MostViewedArtworks)
                        {
                            <a asp-controller="Artworks" asp-action="Details" asp-route-id="@artwork.ArtworkId" class="dashboard-ranking-item">

                                <span class="dashboard-ranking-position">
                                    @position.ToString("00")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(artwork.ImageUrl))
                                {
                                    <img src="@artwork.ImageUrl" alt="" class="dashboard-artwork-image" />
                                }

                                <div class="dashboard-ranking-content">

                                    <strong>
                                        @artwork.Title
                                    </strong>

                                    <span>
                                        @artwork.ArtistName
                                    </span>

                                </div>

                                <div class="dashboard-ranking-value">

                                    <strong>
                                        @artwork.Count
                                    </strong>

                                    <span>
                                        visualizzazioni
                                    </span>

                                </div>

                            </a>

                            position++;
                        }

                    </div>
                }
                else
                {
                    <div class="dashboard-empty">

                        Non sono ancora presenti dati
                        sulle visualizzazioni.

                    </div>
                }

            </article>

            @* Opere più aggiunte ai preferiti *@

            <article class="dashboard-panel">

                <div class="dashboard-panel-header">

                    <div>

                        <span class="gallery-eyebrow">
                            Interesse
                        </span>

                        <h2>
                            Opere più apprezzate
                        </h2>

                    </div>

                </div>

                @if (Model.MostFavoritedArtworks.Any())
                {
                    <div class="dashboard-ranking">

                        @{
                            var position = 1;
                        }

                        @foreach (var artwork in Model.MostFavoritedArtworks)
                        {
                            <a asp-controller="Artworks" asp-action="Details" asp-route-id="@artwork.ArtworkId" class="dashboard-ranking-item">

                                <span class="dashboard-ranking-position">
                                    @position.ToString("00")
                                </span>


                                @if (!string.IsNullOrWhiteSpace(artwork.ImageUrl))
                                {
                                    <img src="@artwork.ImageUrl" alt="" class="dashboard-artwork-image" />
                                } 

                                <div class="dashboard-ranking-content">

                                    <strong>
                                        @artwork.Title
                                    </strong>

                                    <span>
                                        @artwork.ArtistName
                                    </span>

                                </div>

                                <div class="dashboard-ranking-value">

                                    <strong>
                                        @artwork.Count
                                    </strong>

                                    <span>
                                        preferiti
                                    </span>

                                </div>

                            </a>

                            position++;
                        }

                    </div>
                }
                else
                {
                    <div class="dashboard-empty">
                        Non sono ancora presenti dati sui preferiti.
                    </div>
                }

            </article>

            @* Opere con più richieste di informazioni *@

            <article class="dashboard-panel">

                <div class="dashboard-panel-header">

                    <div>

                        <span class="gallery-eyebrow">
                            Interesse commerciale
                        </span>

                        <h2>
                            Opere più richieste
                        </h2>

                    </div>

                </div>

                @if (Model.MostRequestedArtworks.Any())
                {
                    <div class="dashboard-ranking">

                        @{
                            var position = 1;
                        }

                        @foreach (var artwork in Model.MostRequestedArtworks)
                        {
                            <a asp-controller="Artworks" asp-action="Details" asp-route-id="@artwork.ArtworkId" class="dashboard-ranking-item">

                                <span class="dashboard-ranking-position">
                                    @position.ToString("00")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(artwork.ImageUrl))
                                {
                                    <img src="@artwork.ImageUrl" alt="" class="dashboard-artwork-image" />
                                }

                                <div class="dashboard-ranking-content">

                                    <strong>
                                        @artwork.Title
                                    </strong>

                                    <span>
                                        @artwork.ArtistName
                                    </span>

                                </div>

                                <div class="dashboard-ranking-value">

                                    <strong>
                                        @artwork.Count
                                    </strong>

                                    <span>
                                        richieste
                                    </span>

                                </div>

                            </a>

                            position++;
                        }

                    </div>
                }
                else
                {
                    <div class="dashboard-empty">
                        Non sono ancora presenti richieste.
                    </div>
                }

            </article>

        </section>

        @* Avvisi automatici *@
        @if (Model.Insights.Any())
        {
            <section class="dashboard-insights">

                <div class="dashboard-section-heading">

                    <div>

                        <span class="gallery-eyebrow">
                            Analisi automatica
                        </span>

                        <h2>
                            Insight
                        </h2>

                    </div>

                    <p>
                        Indicazioni generate automaticamente
                        sulla base dei dati raccolti dalla piattaforma.
                    </p>

                </div>


                <div class="dashboard-insights-grid">

                    @foreach (var insight in Model.Insights)
                    {
                        <article class="dashboard-insight dashboard-insight-@insight.Type">

                            <span class="dashboard-insight-label">
                                Insight
                            </span>

                            <h3>
                                @insight.Title
                            </h3>

                            <p>
                                @insight.Description
                            </p>

                        </article>
                    }

                </div>

            </section>
        }

        @* Prossime attività con i posti prenotati *@

        <section class="dashboard-panel dashboard-activities-panel">

            <div class="dashboard-panel-header">

                <div>

                    <span class="gallery-eyebrow">
                        Agenda
                    </span>

                    <h2>
                        Prossime attività
                    </h2>

                </div>

                <a asp-controller="GalleryActivities"
                   asp-action="Index"
                   class="dashboard-text-link">

                    Visualizza tutte →

                </a>

            </div>

            @if (Model.UpcomingActivitiesList.Any())
            {
                <div class="dashboard-activities">

                    @foreach (var activity in Model.UpcomingActivitiesList)
                    {
                        <a asp-controller="GalleryActivities" asp-action="Details" asp-route-id="@activity.Id" class="dashboard-activity">

                            <div class="dashboard-activity-date">

                                <strong>
                                    @activity.StartDateTime.ToString("dd")
                                </strong>

                                <span>
                                    @activity.StartDateTime.ToString("MMM")
                                </span>

                            </div>

                            <div class="dashboard-activity-content">

                                <strong>
                                    @activity.Title
                                </strong>

                                <span>
                                    @activity.StartDateTime.ToString("HH:mm")
                                </span>

                            </div>

                            <div class="dashboard-activity-capacity">

                                <div>

                                    <span>
                                        Partecipanti
                                    </span>

                                    <strong>
                                        @activity.BookedParticipants /
                                        @activity.MaxParticipants
                                    </strong>

                                </div>

                                <div class="dashboard-progress">

                                    <span style="width:
                                        @($"{activity.OccupancyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")">
                                    </span>

                                </div>

                            </div>

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="dashboard-empty">
                    Non ci sono attività future programmate.
                </div>
            }

        </section>


        @* Dati dei grafici in formato JSON, letti da dashboard.js *@

        <script id="dashboardData" type="application/json">

                    @Html.Raw(JsonSerializer.Serialize(
                                    new
                                    {
                                            bookings = Model.BookingsByMonth,
                                            inquiries = new
                                            {
                                                    newCount = Model.NewInquiries,

                                                    inProgressCount = Model.InProgressInquiries,

                                                    closedCount = Model.ClosedInquiries
                                            }
                                    }
                            )
                    )

        </script>

    </div>

</div>


@section Scripts
{
    @* Chart.js da CDN con versione fissa:
       un aggiornamento della libreria non può rompere i grafici *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.6.1">
    </script>

    @* Script che disegna i grafici *@
    <script src="~/js/dashboard.js" asp-append-version="true">
    </script>
}