@using BeArtGallery.Models.Enums
@model BeArtGallery.Models.GalleryActivity

@{
    ViewData["Title"] = "Crea attività";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index" class="gx-back-link">
            ← Torna agli eventi
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="gx-form-card">
                <div>

                    <div class="gallery-eyebrow mb-2">
                        Eventi
                    </div>

                    <h1 class="gx-form-title">
                        Crea evento
                    </h1>

                    <p class="gx-page-intro mb-4">
                        Inserisci le informazioni dell'attività che sarà pubblicata nella galleria.
                    </p>

                    @* Form per una nuova attività *@
                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">
                                Titolo
                            </label>

                            @* Titolo e descrizione *@
                            <input asp-for="Title" class="form-control" placeholder="Es. Inaugurazione della mostra «Orizzonti sospesi»" />

                            <span asp-validation-for="Title" class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Descrizione
                            </label>

                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Descrivi brevemente l'evento...">
                            </textarea>

                            <span asp-validation-for="Description" class="text-danger">
                            </span>
                        </div>

                        @* Nel sito si creano solo eventi *@
                        <input type="hidden" name="ActivityType" value="Evento" />

                        <div class="mb-3">
                            <label asp-for="StartDateTime" class="form-label">
                                Data e ora
                            </label>

                            @* Data e ora di inizio (deve essere futura) *@
                            <input asp-for="StartDateTime" type="datetime-local" class="form-control" />

                            <span asp-validation-for="StartDateTime" class="text-danger">
                            </span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="DurationMinutes" class="form-label">
                                    Durata in minuti
                                </label>

                                @* Durata in minuti e numero massimo di partecipanti *@
                                <input asp-for="DurationMinutes" type="number" min="15" max="480" class="form-control" />

                                <span asp-validation-for="DurationMinutes" class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxParticipants" class="form-label">
                                    Numero massimo partecipanti
                                </label>

                                <input asp-for="MaxParticipants" type="number" min="1" max="500" class="form-control" />

                                <span asp-validation-for="MaxParticipants" class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">
                                Luogo
                            </label>

                            @* Luogo *@
                            <input asp-for="Location" class="form-control" placeholder="Es. Sala 1" />

                            <span asp-validation-for="Location" class="text-danger">
                            </span>
                        </div>

                      @* Campo non più usato: le nuove attività sono sempre attive *@
                      @*   <div class="form-check mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Attività attiva
                            </label>

                            <span asp-validation-for="IsActive"
                                  class="text-danger">
                            </span>

                        </div>
 *@
                        <div class="d-flex gap-2">

                            @* Pulsanti Salva e Annulla *@
                            <button type="submit" class="btn gallery-btn-primary">
                                Crea attività
                            </button>

                            <a asp-action="Index" class="btn gallery-btn-outline">
                                Annulla
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@* Script per controllare il form prima dell'invio *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}