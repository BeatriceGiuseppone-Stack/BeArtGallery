@model IEnumerable<BeArtGallery.ViewModels.GalleryActivityViewModel>
@using System.Globalization
@using BeArtGallery.Models.Enums
@using BeArtGallery.Authorization

@{
    ViewData["Title"] = "Visite ed eventi";

    var showCancelled = ViewBag.ShowCancelled != null && (bool)ViewBag.ShowCancelled;

    var cancelledCount = ViewBag.CancelledCount != null ? (int)ViewBag.CancelledCount : 0;

    var showPast = ViewBag.ShowPast != null && (bool)ViewBag.ShowPast;

    var pastCount = ViewBag.PastCount != null ? (int)ViewBag.PastCount : 0;

    var canViewHistory = ViewBag.CanViewHistory != null && (bool)ViewBag.CanViewHistory;

    var isStaff = User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin);

    // Date in italiano (es. "14 novembre", "venerdì")
    var it = new CultureInfo("it-IT");
}

<div class="container py-5">

    @* Intestazione della pagina *@

    <div class="gx-page-head">

        <div>

            <div class="gallery-eyebrow mb-2">
                Il programma della galleria
            </div>

            <h1 class="gx-page-title">
                Visite ed eventi
            </h1>

            <p class="gx-page-intro">
                Visite guidate alla collezione, incontri con gli artisti e
                inaugurazioni. Scegli un appuntamento e prenota il tuo posto.
            </p>

        </div>

        <div class="gx-page-actions">

            @* Pulsante per mostrare o nascondere le attività annullate *@

            @if (cancelledCount > 0)
            {
                @if (!showCancelled)
                {
                    <a asp-controller="GalleryActivities"
                       asp-action="Index"
                       asp-route-showCancelled="true"
                       asp-route-showPast="@showPast"
                       class="btn gallery-btn-outline">

                        Mostra annullate (@cancelledCount)

                    </a>
                }
                else
                {
                    <a asp-controller="GalleryActivities"
                       asp-action="Index"
                       asp-route-showCancelled="false"
                       asp-route-showPast="@showPast"
                       class="btn gallery-btn-outline">

                        Nascondi annullate

                    </a>
                }
            }

            @* Storico e creazione: solo Staff e Admin *@

            @if (isStaff)
            {
                @if (canViewHistory && pastCount > 0)
                {
                    @if (!showPast)
                    {
                        <a asp-controller="GalleryActivities"
                           asp-action="Index"
                           asp-route-showPast="true"
                           asp-route-showCancelled="@showCancelled"
                           class="btn gallery-btn-outline">

                            Mostra storico (@pastCount)

                        </a>
                    }
                    else
                    {
                        <a asp-controller="GalleryActivities"
                           asp-action="Index"
                           asp-route-showPast="false"
                           asp-route-showCancelled="@showCancelled"
                           class="btn gallery-btn-outline">

                            Nascondi storico

                        </a>
                    }
                }

                <a asp-controller="GalleryActivities"
                   asp-action="Create"
                   class="btn gallery-btn-primary">

                    Nuova attività

                </a>
            }

        </div>

    </div>

    @* Messaggi di conferma o errore *@

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (showCancelled)
    {
        <p class="gx-filter-note">
            Stai vedendo anche le attività annullate.
        </p>
    }

    @* Nessuna attività disponibile *@

    @if (!Model.Any())
    {
        <div class="gx-empty">

            <h2>
                Nessun appuntamento in calendario
            </h2>

            <p>
                Al momento non ci sono visite o eventi in programma.
                Il calendario si aggiorna a ogni nuova mostra: nel frattempo
                puoi esplorare la collezione.
            </p>

            <a asp-controller="Artworks"
               asp-action="Index"
               class="btn gallery-btn-outline">

                Esplora le opere

            </a>

        </div>
    }
    else
    {
        <div class="gx-program">

            @foreach (var item in Model)
            {
                var isCancelled = item.Status == GalleryActivityStatus.Cancelled;
                var isPast = item.StartDateTime <= DateTime.Now;
                var isClosed = isCancelled || isPast;
                var isSoldOut = !isClosed && item.AvailablePlaces <= 0;
                var occupancy = item.MaxParticipants > 0
                    ? Math.Min(100, item.BookedParticipants * 100 / item.MaxParticipants)
                    : 0;

                <article class="gx-event @(isClosed ? "is-closed" : "") @(isSoldOut ? "is-soldout" : "")">

                    @* Blocco data, come nel calendario di una mostra *@

                    <a asp-controller="GalleryActivities"
                       asp-action="Details"
                       asp-route-id="@item.Id"
                       class="gx-event-date"
                       tabindex="-1"
                       aria-hidden="true">

                        <span class="gx-event-day">@item.StartDateTime.ToString("dd", it)</span>

                        <span class="gx-event-month">@item.StartDateTime.ToString("MMMM yyyy", it)</span>

                        <span class="gx-event-time">
                            @item.StartDateTime.ToString("dddd", it), ore @item.StartDateTime.ToString("HH:mm", it)
                        </span>

                    </a>

                    <div class="gx-event-body">

                        @* Tipo di attività e stato *@

                        <div class="gx-event-tags">

                            @if (item.ActivityType == ActivityType.Visita)
                            {
                                <span class="gx-tag">Visita guidata</span>
                            }
                            else
                            {
                                <span class="gx-tag">Evento</span>
                            }

                            @if (isCancelled)
                            {
                                <span class="gx-tag gx-tag-alert">Annullata</span>
                            }
                            else if (isClosed)
                            {
                                <span class="gx-tag gx-tag-muted">Conclusa</span>
                            }
                            else if (isSoldOut)
                            {
                                <span class="gx-tag gx-tag-muted">Tutto esaurito</span>
                            }

                        </div>

                        <h2 class="gx-event-title">

                            <a asp-controller="GalleryActivities"
                               asp-action="Details"
                               asp-route-id="@item.Id">

                                @item.Title

                            </a>

                        </h2>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="gx-event-text">
                                @item.Description
                            </p>
                        }

                        <dl class="gx-event-facts">

                            <div>
                                <dt>Durata</dt>
                                <dd>@item.DurationMinutes minuti</dd>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Location))
                            {
                                <div>
                                    <dt>Luogo</dt>
                                    <dd>@item.Location</dd>
                                </div>
                            }

                        </dl>

                        @* Annullamento o disponibilità dei posti *@

                        @if (isCancelled)
                        {
                            <div class="gx-notice gx-notice-alert">

                                <strong>Attività annullata.</strong>

                                @if (!string.IsNullOrWhiteSpace(item.CancellationReason))
                                {
                                    <span>Motivo: @item.CancellationReason</span>
                                }

                            </div>
                        }
                        else if (isClosed)
                        {
                            <p class="gx-seats-label">
                                Prenotazioni chiuse
                            </p>
                        }
                        else
                        {
                            <div class="gx-seats">

                                <p class="gx-seats-label">

                                    @if (isSoldOut)
                                    {
                                        <span>Posti esauriti</span>
                                    }
                                    else
                                    {
                                        <span>
                                            <strong>@item.AvailablePlaces</strong>
                                            @(item.AvailablePlaces == 1 ? "posto libero" : "posti liberi")
                                            su @item.MaxParticipants
                                        </span>
                                    }

                                </p>

                                <div class="gx-seats-bar" aria-hidden="true">
                                    <span style="width: @(occupancy)%"></span>
                                </div>

                            </div>
                        }

                        @* Azioni *@

                        <div class="gx-event-actions">

                            @if (!isClosed && !isSoldOut)
                            {
                                <a asp-controller="GalleryActivities"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn gallery-btn-primary">

                                    Scopri e prenota

                                </a>
                            }
                            else
                            {
                                <a asp-controller="GalleryActivities"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn gallery-btn-outline">

                                    Vedi dettagli

                                </a>
                            }

                            @* Azioni riservate a Staff e Admin *@

                            @if (isStaff)
                            {
                                <div class="gx-staff-actions">

                                    @* Modifica e annullamento solo per attività future e programmate *@

                                    @if (item.Status == GalleryActivityStatus.Scheduled && item.StartDateTime > DateTime.Now)
                                    {
                                        <a asp-controller="GalleryActivities"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id">

                                            Modifica

                                        </a>

                                        <a asp-controller="GalleryActivities"
                                           asp-action="Cancel"
                                           asp-route-id="@item.Id"
                                           class="is-danger">

                                            Annulla attività

                                        </a>
                                    }

                                    @* Eliminazione solo se non esistono prenotazioni *@

                                    @if (!item.HasBookings && item.Status == GalleryActivityStatus.Scheduled)
                                    {
                                        <a asp-controller="GalleryActivities"
                                           asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="is-danger">

                                            Elimina

                                        </a>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>
