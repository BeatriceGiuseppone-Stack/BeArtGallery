@using BeArtGallery.Models.Enums
@model BeArtGallery.Models.GalleryActivity

@{
    ViewData["Title"] = "Modifica attività";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index" class="gx-back-link">
            ← Torna agli eventi
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="gx-form-card">
                <div>

                    <div class="gallery-eyebrow mb-2">
                        Eventi
                    </div>

                    <h1 class="gx-form-title">
                        Modifica visita o evento
                    </h1>

                    <p class="gx-page-intro mb-4">
                        Aggiorna le informazioni dell'attività selezionata.
                    </p>

                    @* Form di modifica dell'attività *@
                    <form asp-action="Edit" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                        </div>

                        @* Id dell'attività (nascosto) *@
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">
                                Titolo
                            </label>

                            @* Titolo e descrizione *@
                            <input asp-for="Title" class="form-control" />

                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Descrizione
                            </label>

                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>

                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ActivityType" class="form-label">
                                Tipo di attività
                            </label>

                            @* Tipo: visita o evento *@
                            <select asp-for="ActivityType" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select">
                            </select>

                            <span asp-validation-for="ActivityType" class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartDateTime" class="form-label">
                                Data e ora
                            </label>

                            @* Data e ora di inizio (deve essere futura) *@
                            <input asp-for="StartDateTime" type="datetime-local" class="form-control" />

                            <span asp-validation-for="StartDateTime" class="text-danger">
                            </span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="DurationMinutes" class="form-label">
                                    Durata in minuti
                                </label>

                                @* Durata in minuti e numero massimo di partecipanti *@
                                <input asp-for="DurationMinutes" type="number" min="15" max="480" class="form-control" />

                                <span asp-validation-for="DurationMinutes" class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxParticipants" class="form-label">
                                    Numero massimo partecipanti
                                </label>

                                <input asp-for="MaxParticipants" type="number" min="1" max="500" class="form-control" />

                                <span asp-validation-for="MaxParticipants" class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">
                                Luogo
                            </label>

                            @* Luogo *@
                            <input asp-for="Location" class="form-control" />

                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                       @* Campo non più usato: le attività restano sempre attive *@
                       @*  <div class="form-check mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Attività attiva
                            </label>

                        </div> *@

                        <div class="d-flex gap-2">

                            @* Pulsanti Salva e Annulla *@
                            <button type="submit" class="btn gallery-btn-primary">
                                Salva modifiche
                            </button>

                            <a asp-action="Index" class="btn gallery-btn-outline">
                                Annulla
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@* Script per controllare il form prima dell'invio *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}