@model BeArtGallery.Models.GalleryActivity
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = "Elimina evento";
}

<div class="container py-5">

    <a asp-action="Index"
       class="gx-back-link">
        ← Torna agli eventi
    </a>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="gx-form-card">

                <div class="gallery-eyebrow mb-2">
                    Eventi
                </div>

                <h1 class="gx-form-title">
                    Eliminare questo evento?
                </h1>

                <p class="gx-page-intro mb-4">
                    L'evento non ha prenotazioni e verrà rimosso dal programma.
                    L'operazione non si può annullare.
                </p>

                <dl class="gx-confirm-list">

                    <dt>Titolo</dt>
                    <dd>@Model.Title</dd>

                    <dt>Tipo</dt>
                    <dd>@(Model.ActivityType == ActivityType.Visita ? "Visita guidata" : "Evento")</dd>

                    <dt>Data</dt>
                    <dd>@Model.StartDateTime.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt>Durata</dt>
                    <dd>@Model.DurationMinutes minuti</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.Location))
                    {
                        <dt>Luogo</dt>
                        <dd>@Model.Location</dd>
                    }

                    <dt>Posti</dt>
                    <dd>@Model.MaxParticipants</dd>

                </dl>

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn gallery-btn-danger">
                            Elimina definitivamente
                        </button>

                        <a asp-action="Index"
                           class="btn gallery-btn-outline">
                            Annulla
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
