@model BeArtGallery.ViewModels.GalleryActivityViewModel
@using System.Globalization
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = Model.Title;

    var isCancelled = Model.Status == GalleryActivityStatus.Cancelled;

    var isPast = Model.StartDateTime <= DateTime.Now;

    var isSoldOut = Model.AvailablePlaces <= 0;

    var canBook = !isCancelled && !isPast && !isSoldOut;

    var it = new CultureInfo("it-IT");

    var endDateTime = Model.StartDateTime.AddMinutes(Model.DurationMinutes);

    var occupancy = Model.MaxParticipants > 0
        ? Math.Min(100, Model.BookedParticipants * 100 / Model.MaxParticipants)
        : 0;
}

<div class="container py-5">

    <a asp-action="Index"
       class="gx-back-link">
        ← Torna a visite ed eventi
    </a>

    <div class="gx-detail">

        @* =================================================
           COLONNA SINISTRA: racconto dell'attività
           ================================================= *@

        <div class="gx-detail-main">

            <div class="gx-event-tags mb-3">

                @if (Model.ActivityType == ActivityType.Visita)
                {
                    <span class="gx-tag">Visita guidata</span>
                }
                else
                {
                    <span class="gx-tag">Evento</span>
                }

                @if (isCancelled)
                {
                    <span class="gx-tag gx-tag-alert">Annullata</span>
                }
                else if (isPast)
                {
                    <span class="gx-tag gx-tag-muted">Conclusa</span>
                }

            </div>

            <h1 class="gx-detail-title">
                @Model.Title
            </h1>

            @* Data in evidenza, come sul cartellone della mostra *@

            <p class="gx-detail-when">
                @Model.StartDateTime.ToString("dddd d MMMM yyyy", it)
                <span>
                    ore @(Model.StartDateTime.ToString("HH:mm", it))–@(endDateTime.ToString("HH:mm", it))
                </span>
            </p>

            @if (isCancelled)
            {
                <div class="gx-notice gx-notice-alert mb-4">

                    <strong>Attività annullata.</strong>

                    <span>
                        Questa attività non è più disponibile
                        e non è possibile effettuare nuove prenotazioni.
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                    {
                        <span>
                            Motivo dell'annullamento: @Model.CancellationReason
                        </span>
                    }

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="gx-detail-lead">
                    @Model.Description
                </p>
            }

            <dl class="gx-detail-facts">

                <div>
                    <dt>Data</dt>
                    <dd>@Model.StartDateTime.ToString("dd/MM/yyyy", it)</dd>
                </div>

                <div>
                    <dt>Ora</dt>
                    <dd>@Model.StartDateTime.ToString("HH:mm", it)</dd>
                </div>

                <div>
                    <dt>Durata</dt>
                    <dd>@Model.DurationMinutes minuti</dd>
                </div>

                <div>
                    <dt>Luogo</dt>
                    <dd>
                        @if (!string.IsNullOrWhiteSpace(Model.Location))
                        {
                            @Model.Location
                        }
                        else
                        {
                            <span class="text-muted">Non specificato</span>
                        }
                    </dd>
                </div>

            </dl>

        </div>

        @* =================================================
           COLONNA DESTRA: biglietteria
           ================================================= *@

        <aside class="gx-ticket-desk" aria-labelledby="bookingTitle">

            <div class="gx-ticket-desk-date" aria-hidden="true">
                <span class="gx-event-day">@Model.StartDateTime.ToString("dd", it)</span>
                <span class="gx-event-month">@Model.StartDateTime.ToString("MMMM", it)</span>
            </div>

            <h2 id="bookingTitle" class="gx-ticket-desk-title">
                Prenotazione
            </h2>

            @if (isCancelled)
            {
                <p class="gx-ticket-desk-note">
                    Le prenotazioni per questa attività
                    sono chiuse perché l'attività è stata annullata.
                </p>
            }
            else if (isPast)
            {
                <p class="gx-ticket-desk-note">
                    Questa attività è già conclusa
                    e non è più possibile prenotare.
                </p>
            }
            else if (isSoldOut)
            {
                <div class="gx-seats">
                    <p class="gx-seats-label">
                        <strong>0</strong> posti liberi su @Model.MaxParticipants
                    </p>
                    <div class="gx-seats-bar" aria-hidden="true">
                        <span style="width: 100%"></span>
                    </div>
                </div>

                <p class="gx-ticket-desk-note">
                    Non ci sono più posti disponibili.
                </p>
            }
            else
            {
                <div class="gx-seats">

                    <p class="gx-seats-label">
                        Posti disponibili:
                        <strong id="availablePlaces">@Model.AvailablePlaces</strong>
                        su @Model.MaxParticipants
                    </p>

                    <div class="gx-seats-bar" aria-hidden="true">
                        <span style="width: @(occupancy)%"></span>
                    </div>

                </div>

                @if (!(User.Identity?.IsAuthenticated ?? false))
                {
                    <p class="gx-ticket-desk-note">
                        Per effettuare una prenotazione
                        devi accedere al tuo account.
                    </p>

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-returnUrl="@Context.Request.Path"
                       class="btn gallery-btn-primary w-100">

                        Accedi per prenotare
                    </a>
                }
                else
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">

                        <label for="numberOfParticipants"
                               class="form-label gx-field-label">

                            Numero partecipanti
                        </label>

                        <input type="number" id="numberOfParticipants" class="form-control gx-field"
                               value="1" min="1" max="10" />

                        <div class="form-text">
                            Fino a 10 persone per prenotazione.
                        </div>
                    </div>

                    <button type="button"
                            id="bookingButton"
                            class="btn gallery-btn-primary w-100">

                        Prenota
                    </button>

                    <div id="bookingMessage"
                         class="mt-3"
                         aria-live="polite">
                    </div>
                }
            }

        </aside>

    </div>
</div>


@if ((User.Identity?.IsAuthenticated ?? false) && canBook)
{
    @section Scripts {

        <script>
            const bookingButton = document.getElementById("bookingButton");

            bookingButton?.addEventListener( "click",  async function () {

                    const participantsInput = document.getElementById("numberOfParticipants");

                    const participants = parseInt(participantsInput.value);

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

                    const message = document.getElementById("bookingMessage");

                    if (isNaN(participants) ||  participants < 1 || participants > 10)
                    {
                        message.innerHTML = `<div class="alert alert-danger">
                                Inserisci un numero di partecipanti
                                compreso tra 1 e 10.
                             </div>`;

                        return;
                    }

                    const availablePlaces =
                        parseInt(
                            document.getElementById(
                                "availablePlaces"
                            ).textContent
                        );

                    if (participants > availablePlaces)
                    {
                        message.innerHTML =
                            `<div class="alert alert-danger">
                                I posti richiesti superano
                                quelli disponibili.
                             </div>`;

                        return;
                    }

                    if (!tokenInput)
                    {
                        message.innerHTML =
                            `<div class="alert alert-danger">
                                Impossibile completare
                                la prenotazione.
                             </div>`;

                        return;
                    }

                    const token =  tokenInput.value;

                    bookingButton.disabled = true;
                    bookingButton.textContent = "Prenotazione in corso...";

                    try {

                        const response = await fetch( "/api/bookings",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type":
                                            "application/json",
                                        "RequestVerificationToken":  token
                                    },

                                    body: JSON.stringify({
                                        galleryActivityId: @Model.Id,
                                        numberOfParticipants:
                                            participants
                                    })
                                }
                            );

                        const result = await response.json();

                        if (response.ok)
                        {
                            message.innerHTML = `<div class="alert alert-success">${result.message} </div>`;

                            const available = document.getElementById("availablePlaces");

                            const newAvailablePlaces = parseInt(available.textContent) - participants;

                            available.textContent = newAvailablePlaces;

                            // Dopo una prenotazione riuscita
                            // non permettiamo un secondo click.
                            bookingButton.textContent = "Prenotazione effettuata";

                            // Se non ci sono più posti,
                            // disabilitiamo anche l'input.
                            if (newAvailablePlaces <= 0)
                            {
                                participantsInput.disabled = true;
                            }
                        }
                        else
                        {
                            message.innerHTML = `<div class="alert alert-danger">${result.message}</div>`;

                            bookingButton.disabled = false;

                            bookingButton.textContent = "Prenota";
                        }
                    }
                    catch (error)
                    {
                        console.error("Errore durante la prenotazione:", error);

                        message.innerHTML =
                            `<div class="alert alert-danger">
                                Si è verificato un errore
                                durante la prenotazione.
                             </div>`;

                        bookingButton.disabled = false;

                        bookingButton.textContent = "Prenota";
                    }

                });
        </script>
    }
}