@model BeArtGallery.ViewModels.GalleryActivityViewModel
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-action="Index"
           class="text-decoration-none text-dark">
            ← Torna a visite ed eventi
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-5">

                    <div class="mb-3">

                        @if (Model.ActivityType == ActivityType.Visita)
                        {
                            <span class="badge bg-dark">
                                Visita
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary">
                                Evento
                            </span>
                        }

                    </div>

                    <h1 class="display-6 fw-semibold mb-3">
                        @Model.Title
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="lead text-muted">
                            @Model.Description
                        </p>
                    }

                    <hr class="my-4" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <strong>Data</strong>
                            <div>
                                @Model.StartDateTime.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <strong>Ora</strong>
                            <div>
                                @Model.StartDateTime.ToString("HH:mm")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <strong>Durata</strong>
                            <div>
                                @Model.DurationMinutes minuti
                            </div>
                        </div>

                        <div class="col-md-6">
                            <strong>Luogo</strong>
                            <div>
                                @Model.Location
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <h2 class="h5">
                        Prenotazione
                    </h2>

                    <p>
                        Posti disponibili:
                        <strong id="availablePlaces">
                            @Model.AvailablePlaces
                        </strong>
                        su @Model.MaxParticipants
                    </p>

                    @if (Model.AvailablePlaces <= 0)
                    {
                        <div class="alert alert-warning">
                            Non ci sono più posti disponibili.
                        </div>
                    }
                    else if (!(User.Identity?.IsAuthenticated ?? false))
                    {
                        <div class="alert alert-light border">

                            Per effettuare una prenotazione devi accedere al tuo account.

                        </div>

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="btn btn-dark">
                            Accedi per prenotare
                        </a>
                    }
                    else
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="numberOfParticipants"
                                   class="form-label">
                                Numero partecipanti
                            </label>

                            <input type="number"
                                   id="numberOfParticipants"
                                   class="form-control"
                                   value="1"
                                   min="1"
                                   max="10"
                                   style="max-width: 150px;" />
                        </div>

                        <button type="button"
                                id="bookingButton"
                                class="btn btn-dark">
                            Prenota
                        </button>

                        <div id="bookingMessage"
                             class="mt-3">
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>

</div>

@if (User.Identity?.IsAuthenticated ?? false)
{
    @section Scripts {

        <script>

            const bookingButton =
                document.getElementById("bookingButton");

            bookingButton?.addEventListener(
                "click",
                async function () {

                    const participants =
                        parseInt(
                            document.getElementById(
                                "numberOfParticipants"
                            ).value
                        );

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    const message =
                        document.getElementById(
                            "bookingMessage"
                        );

                    bookingButton.disabled = true;

                    try {

                        const response = await fetch(
                            "/api/bookings",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token
                                },

                                body: JSON.stringify({
                                    galleryActivityId: @Model.Id,
                                    numberOfParticipants: participants
                                })
                            }
                        );

                        const result = await response.json();

                        if (response.ok) {

                            message.innerHTML =
                                `<div class="alert alert-success">
                                    ${result.message}
                                 </div>`;

                            const available =
                                document.getElementById(
                                    "availablePlaces"
                                );

                            available.textContent =
                                parseInt(available.textContent)
                                - participants;
                        }
                        else {

                            message.innerHTML =
                                `<div class="alert alert-danger">
                                    ${result.message}
                                 </div>`;

                            bookingButton.disabled = false;
                        }

                    }
                    catch {

                        message.innerHTML =
                            `<div class="alert alert-danger">
                                Si è verificato un errore durante la prenotazione.
                             </div>`;

                        bookingButton.disabled = false;
                    }
                });

        </script>

    }
}