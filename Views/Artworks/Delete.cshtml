@model BeArtGallery.Models.Artwork

@{
    ViewData["Title"] = "Elimina opera";
}

<div class="container py-5">

    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="gx-back-link">
        ← Torna all'opera
    </a>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="gx-form-card">

                <div class="gallery-eyebrow mb-2">
                    Catalogo opere
                </div>

                <h1 class="gx-form-title">
                    Eliminare questa opera?
                </h1>

                <p class="gx-page-intro mb-4">
                    L'opera verrà rimossa dal catalogo insieme alla sua immagine.
                    L'operazione non si può annullare.
                </p>

                <dl class="gx-confirm-list">

                    <dt>Titolo</dt>
                    <dd>@Model.Title</dd>

                    <dt>Artista</dt>
                    <dd>@(Model.Artist != null ? Model.Artist.FirstName + " " + Model.Artist.LastName : "—")</dd>

                    @if (Model.Year.HasValue)
                    {
                        <dt>Anno</dt>
                        <dd>@Model.Year</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Technique))
                    {
                        <dt>Tecnica</dt>
                        <dd>@Model.Technique</dd>
                    }

                    <dt>In esposizione</dt>
                    <dd>@(Model.IsOnDisplay ? "Sì" : "No")</dd>

                </dl>

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn gallery-btn-danger">
                            Elimina definitivamente
                        </button>

                        <a asp-action="Index"
                           class="btn gallery-btn-outline">
                            Annulla
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
