@model BeArtGallery.Models.Artwork

@{
    ViewData["Title"] = "Elimina opera";
}

<div class="container py-5">

    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="gx-back-link">
        ← Torna all'opera
    </a>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="gx-form-card">

                <div class="gallery-eyebrow mb-2">
                    Catalogo opere
                </div>

                <h1 class="gx-form-title">
                    Eliminare questa opera?
                </h1>

                <p class="gx-page-intro mb-4">
                    L'opera verrà rimossa dal catalogo insieme alla sua immagine.
                    L'operazione non si può annullare.
                </p>

                <dl class="gx-confirm-list">

                    <dt>Titolo</dt>
                    <dd>@Model.Title</dd>

                    <dt>Artista</dt>
                    <dd>@(Model.Artist != null ? Model.Artist.FirstName + " " + Model.Artist.LastName : "—")</dd>

                    @if (Model.Year.HasValue)
                    {
                        <dt>Anno</dt>
                        <dd>@Model.Year</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Technique))
                    {
                        <dt>Tecnica</dt>
                        <dd>@Model.Technique</dd>
                    }

                    <dt>In esposizione</dt>
                    <dd>@(Model.IsOnDisplay ? "Sì" : "No")</dd>

                </dl>

                @{
                    var openInquiries = ViewBag.OpenInquiries is int o ? o : 0;
                    var closedInquiries = ViewBag.ClosedInquiries is int c ? c : 0;
                }

                @if (openInquiries > 0)
                {
                    @* Una conversazione ancora in corso blocca l'eliminazione:
                       lo staff deve prima chiuderla. *@

                    <div class="alert alert-danger mb-4"
                         role="alert">

                        @ArtworksController.OpenInquiryDeleteError

                        <div class="mt-2">
                            @(openInquiries == 1
                                ? "C'è 1 richiesta aperta"
                                : $"Ci sono {openInquiries} richieste aperte")
                            su questa opera: apri le richieste, rispondi se
                            serve e imposta lo stato <em>Chiusa</em>.
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="ArtworkInquiries"
                           asp-action="Index"
                           class="btn gallery-btn-primary">
                            Vai alle richieste
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn gallery-btn-outline">
                            Torna all'opera
                        </a>

                    </div>
                }
                else
                {
                    if (closedInquiries > 0)
                    {
                        <div class="alert alert-warning mb-4"
                             role="status">
                            @(closedInquiries == 1
                                ? "Questa opera ha 1 richiesta di informazioni già chiusa: resterà consultabile dal visitatore e dallo staff, segnata come «Opera non più disponibile»."
                                : $"Questa opera ha {closedInquiries} richieste di informazioni già chiuse: resteranno consultabili dai visitatori e dallo staff, segnate come «Opera non più disponibile».")
                        </div>
                    }

                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn gallery-btn-danger">
                                Elimina definitivamente
                            </button>

                            <a asp-action="Index"
                               class="btn gallery-btn-outline">
                                Annulla
                            </a>

                        </div>

                    </form>
                }

            </div>

        </div>

    </div>

</div>
