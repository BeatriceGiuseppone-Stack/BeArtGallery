@model BeArtGallery.Models.Artwork
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = "Modifica opera";
}

<div class="container py-5">

    @* Navigazione *@

    <div class="mb-5">

        <a asp-controller="Artworks"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="gallery-back-link">

            ← Torna all'opera

        </a>

    </div>


    <div class="row g-5">

        <div class="col-lg-8">

            <div class="gallery-eyebrow mb-3">
                Gestione opere
            </div>

            <h1 class="gallery-form-title">
                Modifica opera
            </h1>

            <p class="gallery-form-intro">
                Aggiorna le informazioni di
                <strong>@Model.Title</strong>.
            </p>


            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data"
                  class="gallery-form">

                <input type="hidden"
                       asp-for="Id" />

                <input type="hidden"
                       asp-for="ImageUrl" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <div class="row g-4">

                    @* Titolo *@

                    <div class="col-12">

                        <label asp-for="Title"
                               class="form-label gallery-form-label">

                            Titolo

                        </label>

                        <input asp-for="Title"
                               class="form-control gallery-form-control" />

                        <span asp-validation-for="Title"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Anno *@

                    <div class="col-md-6">

                        <label asp-for="Year"
                               class="form-label gallery-form-label">

                            Anno

                        </label>

                        <input asp-for="Year"
                               type="number"
                               class="form-control gallery-form-control" />

                        <span asp-validation-for="Year"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Tecnica *@

                    <div class="col-md-6">

                        <label asp-for="Technique"
                               class="form-label gallery-form-label">

                            Tecnica

                        </label>

                        <input asp-for="Technique"
                               class="form-control gallery-form-control" />

                        <span asp-validation-for="Technique"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Artista *@

                    <div class="col-12">

                        <label asp-for="ArtistId"
                               class="form-label gallery-form-label">

                            Artista

                        </label>

                        <select asp-for="ArtistId"
                                asp-items="ViewBag.ArtistId"
                                class="form-select gallery-form-control">

                            <option value="">
                                Seleziona un artista
                            </option>

                        </select>

                        <span asp-validation-for="ArtistId"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-12">

    <label asp-for="AvailabilityStatus"
           class="form-label gallery-form-label">

        Disponibilità

    </label>

    <select asp-for="AvailabilityStatus"
            class="form-select gallery-form-control">

        <option value="@ArtworkAvailabilityStatus.Available">
            Disponibile
        </option>

        <option value="@ArtworkAvailabilityStatus.LimitedAvailability">
            Disponibilità limitata
        </option>

        <option value="@ArtworkAvailabilityStatus.SoldOut">
            Esaurita
        </option>

        <option value="@ArtworkAvailabilityStatus.Unavailable">
            Non disponibile
        </option>

    </select>

    <span asp-validation-for="AvailabilityStatus"
          class="text-danger small">
    </span>

</div>

                    @* Descrizione *@

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label gallery-form-label">

                            Descrizione

                        </label>

                        <textarea asp-for="Description"
                                  class="form-control gallery-form-control"
                                  rows="7"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Immagine attuale *@

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <div class="col-12">

                            <div class="gallery-eyebrow mb-3">
                                Immagine attuale
                            </div>

                            <div class="artwork-current-image">

                                <img src="@Model.ImageUrl"
                                     alt="@Model.Title" />

                            </div>

                        </div>
                    }


                    @* Sostituzione immagine *@

                    <div class="col-12">

                        <label for="imageFile"
                               class="form-label gallery-form-label">

                            Sostituisci immagine

                        </label>

                        <input type="file"
                               id="imageFile"
                               name="imageFile"
                               class="form-control gallery-form-control"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <div class="form-text">
                            Lascia vuoto per mantenere
                            l'immagine attuale.
                            Formati supportati: JPG, PNG e WEBP.
                            Dimensione massima 5 MB.
                        </div>


                        <div id="imagePreviewContainer"
                             class="artwork-upload-preview d-none">

                            <div class="gallery-eyebrow mb-2">
                                Nuova anteprima
                            </div>

                            <img id="imagePreview"
                                 src=""
                                 alt="Anteprima della nuova immagine" />

                        </div>

                    </div>


                    @* Stato esposizione *@

                    <div class="col-12">

                        <div class="gallery-checkbox-wrapper">

                            <input asp-for="IsOnDisplay"
                                   class="form-check-input" />

                            <label asp-for="IsOnDisplay"
                                   class="form-check-label">

                                Opera attualmente esposta in galleria

                            </label>

                        </div>

                    </div>

                </div>


                <div class="gallery-form-actions">

                    <button type="submit"
                            class="btn gallery-btn-primary">

                        Salva modifiche

                    </button>

                    <a asp-controller="Artworks"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn gallery-btn-outline">

                        Annulla

                    </a>

                </div>

            </form>

        </div>


        @* Pannello informativo *@

        <div class="col-lg-4 d-none d-lg-block">

            <div class="gallery-form-side">

                <div>

                    <div class="gallery-eyebrow mb-3">
                        Catalogo
                    </div>

                    <h2>
                        @Model.Title
                    </h2>

                    <p>
                        Le modifiche apportate saranno
                        immediatamente visibili nella
                        scheda pubblica dell'opera.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const imageFile =
            document.getElementById("imageFile");

        const imagePreview =
            document.getElementById("imagePreview");

        const imagePreviewContainer =
            document.getElementById("imagePreviewContainer");


        imageFile?.addEventListener(
            "change",
            function () {

                const file =
                    this.files?.[0];


                if (!file) {

                    imagePreview.src = "";

                    imagePreviewContainer
                        .classList
                        .add("d-none");

                    return;
                }


                const reader =
                    new FileReader();


                reader.onload = function (event) {

                    imagePreview.src =
                        event.target.result;

                    imagePreviewContainer
                        .classList
                        .remove("d-none");

                };


                reader.readAsDataURL(file);

            });

    </script>

}