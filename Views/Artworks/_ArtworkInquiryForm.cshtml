@model BeArtGallery.ViewModels.ArtworkInquiryViewModel

<form asp-controller="Artworks"
      asp-action="RequestInformation"
      method="post"
      class="artwork-inquiry-form">

    <input asp-for="ArtworkId"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-4"
         role="alert">
    </div>


    <div class="row g-4">

        <div class="col-md-6">

            <label asp-for="Name"
                   class="form-label gallery-form-label">

                Nome

            </label>

            <input asp-for="Name"
                   class="form-control gallery-form-control"
                   autocomplete="name"
                   placeholder="Il tuo nome" />

            <span asp-validation-for="Name"
                  class="text-danger small">
            </span>

        </div>


        <div class="col-md-6">

            <label asp-for="Email"
                   class="form-label gallery-form-label">

                Email

            </label>

            <input asp-for="Email"
                   class="form-control gallery-form-control"
                   autocomplete="email"
                   placeholder="nome@email.it" />

            <span asp-validation-for="Email"
                  class="text-danger small">
            </span>

        </div>


        <div class="col-12">

            <label asp-for="Message"
                   class="form-label gallery-form-label">

                Messaggio

            </label>

            <textarea asp-for="Message"
                      class="form-control gallery-form-control"
                      rows="5"
                      placeholder="Scrivi qui la tua richiesta..."></textarea>

            <span asp-validation-for="Message"
                  class="text-danger small">
            </span>

        </div>

    </div>


    <div class="artwork-inquiry-form-footer">

        <p>
            I dati inseriti saranno utilizzati
            esclusivamente per rispondere alla tua richiesta.
        </p>


        <button type="submit"
                class="btn gallery-btn-primary">

            Invia richiesta

        </button>

    </div>

</form>