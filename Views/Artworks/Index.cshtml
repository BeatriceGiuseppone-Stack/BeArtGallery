@model IEnumerable<BeArtGallery.Models.Artwork>
@using BeArtGallery.Authorization

@{
    ViewData["Title"] = "Catalogo opere";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Catalogo opere</h1>
            <p class="text-muted mb-0">
                Scopri le opere presenti nella galleria.
            </p>
        </div>

       @if (User.IsInRole(RoleNames.Staff) ||
     User.IsInRole(RoleNames.Admin))
{
    <a asp-action="Create"
       class="btn btn-dark">
        Aggiungi opera
    </a>
}
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border">
            Non sono ancora presenti opere nel catalogo.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @foreach (var item in Model)
            {
                <div class="col">

                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 alt="@item.Title"
                                 style="height: 300px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-muted"
                                 style="height: 300px;">
                                <span>Nessuna immagine disponibile</span>
                            </div>
                        }

                        <div class="card-body">

                            <h5 class="card-title mb-2">
                                @item.Title
                            </h5>

                            <p class="card-text mb-1">
                                <strong>Artista:</strong>
                                @if (item.Artist != null)
                                {
                                    <span>
                                        @item.Artist.FirstName @item.Artist.LastName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Non disponibile
                                    </span>
                                }
                            </p>

                            @if (item.Year.HasValue)
                            {
                                <p class="card-text mb-1">
                                    <strong>Anno:</strong> @item.Year
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Technique))
                            {
                                <p class="card-text mb-1">
                                    <strong>Tecnica:</strong> @item.Technique
                                </p>
                            }

                            <p class="mt-3 mb-0">
                                @if (item.IsOnDisplay)
                                {
                                    <span class="badge bg-success">
                                        In esposizione
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Non in esposizione
                                    </span>
                                }
                            </p>

                        </div>

                        <div class="card-footer bg-white border-0 pb-3">

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-dark btn-sm">
                                    Dettagli
                                </a>

                                @if (User.IsInRole(RoleNames.Staff) ||
     User.IsInRole(RoleNames.Admin))
{
    <a asp-action="Edit"
       asp-route-id="@item.Id"
       class="btn btn-outline-primary btn-sm">
        Modifica
    </a>

    <a asp-action="Delete"
       asp-route-id="@item.Id"
       class="btn btn-outline-danger btn-sm">
        Elimina
    </a>
}

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>