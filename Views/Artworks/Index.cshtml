@model IEnumerable<BeArtGallery.Models.Artwork>
@using BeArtGallery.Authorization
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = "Catalogo opere";
}

<div class="container py-5">

    @* Intestazione della pagina *@

    <div class="d-flex justify-content-between
                align-items-end
                flex-wrap
                gap-3
                mb-5">

        <div>

            <div class="gallery-eyebrow mb-3">
                La collezione
            </div>

            <h1 class="artworks-page-title">
                Catalogo opere
            </h1>

            <p class="artworks-page-intro">
                Esplora le opere presenti nella collezione
                di BeArtGallery e scopri gli artisti,
                le tecniche e le storie che le accompagnano.
            </p>

        </div>


        @if (User.IsInRole(RoleNames.Staff) ||
             User.IsInRole(RoleNames.Admin))
        {
            <a asp-controller="Artworks"
               asp-action="Create"
               class="btn gallery-btn-primary">

                Nuova opera

            </a>
        }

    </div>


    @* Messaggi *@

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">

            @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4">

            @TempData["ErrorMessage"]

        </div>
    }


    @* Catalogo *@

    @if (!Model.Any())
    {
        <div class="artwork-empty-state">

            <div class="gallery-eyebrow mb-2">
                Collezione
            </div>

            <h2>
                Nessuna opera presente
            </h2>

            <p>
                Il catalogo di BeArtGallery
                non contiene ancora opere.
            </p>

        </div>
    }
    else
    {
        <div class="row g-5">

            @foreach (var artwork in Model)
            {
                <div class="col-md-6 col-xl-4">

                    <article class="artwork-catalog-card">

                        @* Immagine *@

                       <a asp-controller="Artworks"
                           asp-action="Details"
                           asp-route-id="@artwork.Id"
                           class="artwork-catalog-image-wrapper">
                        
                            @if (!string.IsNullOrWhiteSpace(artwork.ImageUrl))
                            {
                                <img src="@artwork.ImageUrl"
                                     alt="@artwork.Title"
                                     class="artwork-catalog-image" />
                            }
                            else
                            {
                                <div class="artwork-catalog-placeholder">
                        
                                    Immagine non disponibile
                        
                                </div>
                            }
                        
                            @* Disponibilità sovrapposta all'immagine *@
                        
                            @if (artwork.AvailabilityStatus ==
                                 ArtworkAvailabilityStatus.SoldOut)
                            {
                                <span class="artwork-catalog-availability-badge
                                             artwork-catalog-availability-soldout">
                        
                                    Esaurito
                        
                                </span>
                            }
                            else if (artwork.AvailabilityStatus ==
                                     ArtworkAvailabilityStatus.LimitedAvailability)
                            {
                                <span class="artwork-catalog-availability-badge
                                             artwork-catalog-availability-limited">
                        
                                    Disponibilità limitata
                        
                                </span>
                            }
                            else if (artwork.AvailabilityStatus ==
                                     ArtworkAvailabilityStatus.Unavailable)
                            {
                                <span class="artwork-catalog-availability-badge
                                             artwork-catalog-availability-unavailable">
                        
                                    Non disponibile
                        
                                </span>
                            }
                        
                        </a>

                        <div class="artwork-catalog-content">

                            @* Stato esposizione *@

                            <div class="mb-3">

                                @if (artwork.IsOnDisplay)
                                {
                                    <span class="gallery-status gallery-status-visible">

                                        In esposizione

                                    </span>
                                }
                                else
                                {
                                    <span class="gallery-status gallery-status-not-visible">

                                        Non esposta

                                    </span>
                                }

                            </div>


                            @* Titolo *@

                            <h2 class="artwork-catalog-title">

                                <a asp-controller="Artworks"
                                   asp-action="Details"
                                   asp-route-id="@artwork.Id">

                                    @artwork.Title

                                </a>

                            </h2>


                            @* Artista *@

                            @if (artwork.Artist != null)
                            {
                                <a asp-controller="Artists"
                                   asp-action="Details"
                                   asp-route-id="@artwork.ArtistId"
                                   class="artwork-catalog-artist">

                                    @artwork.Artist.FirstName
                                    @artwork.Artist.LastName

                                </a>
                            }


                            @* Metadati *@

                            <div class="artwork-catalog-meta">

                                @if (artwork.Year.HasValue)
                                {
                                    <span>
                                        @artwork.Year
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    artwork.Technique))
                                {
                                    <span>
                                        @artwork.Technique
                                    </span>
                                }

                            </div>


                            @* Azione pubblica *@

                            <div class="artwork-catalog-actions">

                                <a asp-controller="Artworks"
                                   asp-action="Details"
                                   asp-route-id="@artwork.Id"
                                   class="artwork-catalog-details-link">

                                    Scopri l'opera →

                                </a>


                                @* Azioni Staff e Admin *@

                                @if (User.IsInRole(RoleNames.Staff) ||
                                     User.IsInRole(RoleNames.Admin))
                                {
                                    <div class="artwork-catalog-admin-actions">

                                        <a asp-controller="Artworks"
                                           asp-action="Edit"
                                           asp-route-id="@artwork.Id"
                                           class="btn btn-sm gallery-btn-outline">

                                            Modifica

                                        </a>


                                        <a asp-controller="Artworks"
                                           asp-action="Delete"
                                           asp-route-id="@artwork.Id"
                                           class="btn btn-sm gallery-btn-danger">

                                            Elimina

                                        </a>

                                    </div>
                                }

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

</div>