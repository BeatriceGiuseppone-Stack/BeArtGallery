@model BeArtGallery.ViewModels.ArtworkDetailsViewModel
@using BeArtGallery.Authorization
@using BeArtGallery.Models.Enums

@* Dati usati in tutta la pagina *@
@{
    var artwork = Model.Artwork;

    ViewData["Title"] = artwork.Title;

    var inquiryHasErrors = !ViewData.ModelState.IsValid;
}


@* Fogli di stile delle audioguide e del QR *@
@section Styles
{
    <link rel="stylesheet" href="~/css/artwork-room-preview.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/artwork-audio-guide.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/artwork-audio-guide.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/artwork-qr.css" asp-append-version="true" />
}

<div class="container py-5">

    @* Messaggi di errore (es. eliminazione non permessa) *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-5" role="alert">

            @TempData["ErrorMessage"]

        </div>
    }

    @* Conferma dopo aver salvato un'audioguida *@
    @if (TempData["AudioGuideSuccess"] != null)
    {
        <div class="alert alert-success mb-5" role="status">

            @TempData["AudioGuideSuccess"]

        </div>
    }

    @* Link per tornare al catalogo *@

    <div class="mb-5">

        <a asp-controller="Artworks" asp-action="Index" class="gallery-back-link">

            ← Torna al catalogo

        </a>

    </div>


    @* Scheda principale: immagine e informazioni *@

    <div class="row g-5 align-items-start">


        @* Immagine dell'opera o segnaposto *@

        <div class="col-lg-6">

            <div class="artwork-detail-image-wrapper">

                @if (!string.IsNullOrWhiteSpace(artwork.ImageUrl))
                {
                    <img src="@artwork.ImageUrl" alt="@artwork.Title" class="artwork-detail-image" />
                }
                else
                {
                    <div class="artwork-detail-placeholder">

                        Immagine non disponibile

                    </div>
                }

            </div>

        </div>


        @* Titolo, artista e azioni *@

        <div class="col-lg-6">

            <div class="artwork-detail-content">

                <div class="gallery-eyebrow mb-3">
                    Opera
                </div>

                <h1 class="artwork-detail-title">

                    @artwork.Title

                </h1>


                @if (artwork.Artist != null)
                {
                    <a asp-controller="Artists" asp-action="Details" asp-route-id="@artwork.ArtistId" class="artwork-detail-artist">

                        @artwork.Artist.FirstName
                        @artwork.Artist.LastName

                    </a>
                }

                @* Azioni principali *@

                <div class="artwork-primary-actions">

                    @* Preferiti: chi non ha fatto l'accesso viene mandato al login *@

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Artworks" asp-action="ToggleFavorite" method="post">

                            <input type="hidden" name="id" value="@artwork.Id" />

                            @if (Model.IsFavorite)
                            {
                                <button type="submit" class="gallery-favorite-button active" aria-label="Rimuovi l'opera dai preferiti">

                                    <span class="gallery-favorite-heart">
                                        ♥
                                    </span>

                                    Nei tuoi preferiti

                                </button>
                            }
                            else
                            {
                                <button type="submit" class="gallery-favorite-button" aria-label="Aggiungi l'opera ai preferiti">

                                    <span class="gallery-favorite-heart">
                                        ♡
                                    </span>

                                    Aggiungi ai preferiti

                                </button>
                            }

                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="gallery-favorite-button">

                            <span class="gallery-favorite-heart">
                                ♡
                            </span>

                            Salva nei preferiti

                        </a>
                    }


                    @* Pulsante che porta al form della richiesta *@

                    <button type="button" class="btn gallery-btn-primary" data-bs-toggle="collapse" data-bs-target="#artworkInquiry"
                            aria-expanded="@(inquiryHasErrors.ToString().ToLower())" aria-controls="artworkInquiry">

                        Richiedi informazioni

                    </button>

                </div>


                @* Conferma dopo l'invio della richiesta *@

                @if (TempData["InquirySuccess"] != null)
                {
                    <div class="artwork-inquiry-success" role="status">

                        <div class="artwork-inquiry-success-title">
                            Richiesta inviata
                        </div>

                        <p class="mb-0">
                            @TempData["InquirySuccess"]
                        </p>

                    </div>
                }

                @* Form "Richiedi informazioni" *@

                <div class="collapse @(inquiryHasErrors ? "show" : "")" id="artworkInquiry">

                    <div class="artwork-inquiry-panel">

                        <div class="gallery-eyebrow mb-2">
                            Contatta la galleria
                        </div>

                        <h2>
                            Richiedi informazioni sull'opera
                        </h2>

                        <p class="artwork-inquiry-intro">

                            Vuoi conoscere maggiori dettagli,
                            informazioni sull'esposizione
                            o sulla collezione?

                            Scrivi alla galleria.

                        </p>


                        @await Html.PartialAsync("_ArtworkInquiryForm", Model.Inquiry)

                    </div>

                </div>

                <div class="artwork-detail-divider">
                </div>

                @* Scheda tecnica: anno, tecnica, dimensioni, esposizione e disponibilità *@

                <div class="gallery-eyebrow mb-3">
                    Scheda tecnica
                </div>

                <dl class="artwork-metadata">

                    @if (artwork.Year.HasValue)
                    {
                        <div class="artwork-metadata-row">

                            <dt>
                                Anno
                            </dt>

                            <dd>
                                @artwork.Year
                            </dd>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(artwork.Technique))
                    {
                        <div class="artwork-metadata-row">

                            <dt>
                                Tecnica
                            </dt>

                            <dd>
                                @artwork.Technique
                            </dd>

                        </div>
                    }


                    @if (artwork.WidthCm.HasValue && artwork.HeightCm.HasValue)
                    {
                        <div class="artwork-metadata-row">

                            <dt>
                                Dimensioni
                            </dt>

                            <dd>

                                @artwork.WidthCm.Value.ToString("0.#")
                                ×
                                @artwork.HeightCm.Value.ToString("0.#")
                                cm

                            </dd>

                        </div>
                    }

                    <div class="artwork-metadata-row">

                        <dt>
                            Esposizione
                        </dt>

                        <dd>

                            @if (artwork.IsOnDisplay)
                            {
                                <span class="gallery-status gallery-status-visible">

                                    Attualmente esposta

                                </span>
                            }
                            else
                            {
                                <span class="gallery-status gallery-status-not-visible">

                                    Non esposta

                                </span>
                            }

                        </dd>

                    </div>


                    <div class="artwork-metadata-row">

                        <dt>
                            Disponibilità
                        </dt>

                        <dd>

                            @* Testo e colore in base alla disponibilità *@
                            @switch (artwork.AvailabilityStatus)
                            {
                                case ArtworkAvailabilityStatus.Available:

                                    <span class="artwork-availability
                                        artwork-availability-available">

                                        Disponibile

                                    </span>

                                    break;


                                case ArtworkAvailabilityStatus.LimitedAvailability:

                                    <span class="artwork-availability
                                        artwork-availability-limited">

                                        Disponibilità limitata

                                    </span>

                                    break;


                                case ArtworkAvailabilityStatus.SoldOut:

                                    <span class="artwork-availability
                                        artwork-availability-sold-out">

                                        Esaurita

                                    </span>

                                    break;


                                case ArtworkAvailabilityStatus.Unavailable:

                                    <span class="artwork-availability
                                        artwork-availability-unavailable">

                                        Non disponibile

                                    </span>

                                    break;
                            }

                        </dd>

                    </div>

                </dl>

            </div>

        </div>

    </div>


    @* Audioguide *@

    @* Separa le audioguide attive da quelle non pubblicate *@
    @{
        var canManageAudio = User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin);

        var activeAudioGuides = artwork.AudioGuides.Where(a => a.IsActive).OrderBy(a => a.LanguageCode).ToList();
    }

    @if (activeAudioGuides.Any() || canManageAudio)
    {
        <section class="artwork-audio-section">


            @* Titolo della sezione e pulsante per aggiungerne una *@

            <div class="artwork-audio-header">

                <div>

                    <div class="gallery-eyebrow mb-3">
                        Ascolta l'opera
                    </div>

                    <h2 class="artwork-audio-title">
                        Audioguida
                    </h2>

                    <p class="artwork-audio-intro">

                        Scopri la storia, il contesto
                        e i dettagli di

                        <strong>
                            @artwork.Title
                        </strong>

                        attraverso l'audioguida
                        di BeArtGallery.

                    </p>

                </div>


                @if (canManageAudio)
                {
                    <a asp-controller="ArtworkAudioGuides" asp-action="Create" asp-route-artworkId="@artwork.Id" class="btn gallery-btn-outline">

                        + Aggiungi audioguida

                    </a>
                }

            </div>


            @* Audioguide pubblicate *@

            @if (activeAudioGuides.Any())
            {
                <div class="artwork-audio-list">

                    @foreach (var guide in activeAudioGuides)
                    {
                        var languageName = guide.LanguageCode switch
                            {
                                "it-IT" => "Italiano",
                                "en-US" => "Inglese",
                                "fr-FR" => "Francese",
                                "es-ES" => "Spagnolo",
                                _ => guide.LanguageCode
                            };


                        <article class="artwork-audio-card">

                            <div class="artwork-audio-card-header">

                                <div>

                                    <span class="artwork-audio-language">

                                        @languageName

                                    </span>


                                    <h3>
                                        @guide.Title
                                    </h3>

                                </div>


                                @if (canManageAudio)
                                {
                                    <div class="artwork-audio-admin-actions">

                                        <a asp-controller="ArtworkAudioGuides" asp-action="Edit" asp-route-id="@guide.Id">

                                            Modifica

                                        </a>

                                        <a asp-controller="ArtworkAudioGuides" asp-action="Delete" asp-route-id="@guide.Id" class="text-danger">

                                            Elimina

                                        </a>

                                    </div>
                                }

                            </div>


                            @* Lettore audio *@

                            <audio controls preload="metadata" class="artwork-audio-player">

                                <source src="@guide.AudioUrl" />

                                Il tuo browser non supporta
                                la riproduzione audio.

                            </audio>


                            @* Trascrizione del testo *@

                            @if (!string.IsNullOrWhiteSpace(guide.Transcript))
                            {
                                <div class="artwork-audio-transcript">

                                    <button class="artwork-transcript-toggle" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#transcript-@guide.Id" aria-expanded="false" aria-controls="transcript-@guide.Id">

                                        Leggi la trascrizione

                                    </button>


                                    <div class="collapse" id="transcript-@guide.Id">

                                        <div class="artwork-transcript-content">

                                            @guide.Transcript

                                        </div>

                                    </div>

                                </div>
                            }

                        </article>
                    }

                </div>
            }
            else if (canManageAudio)
            {
                @* Nessuna audioguida: messaggio per lo staff *@
                <div class="artwork-audio-empty">

                    <strong>
                        Nessuna audioguida attiva
                    </strong>

                    <p>

                        Aggiungi un'audioguida per rendere
                        disponibile un nuovo contenuto
                        ai visitatori.

                    </p>

                </div>
            }


            @* Audioguide non pubblicate, visibili solo a Staff e Admin *@

            @if (canManageAudio)
            {
                var inactiveAudioGuides = artwork.AudioGuides.Where(a => !a.IsActive).OrderBy(a => a.LanguageCode).ToList();


                if (inactiveAudioGuides.Any())
                {
                    <div class="artwork-inactive-audio">

                        <div class="gallery-eyebrow mb-3">

                            Audioguide non pubblicate

                        </div>


                        @foreach (var guide in inactiveAudioGuides)
                        {
                            var inactiveLanguageName = guide.LanguageCode switch
                                {
                                    "it-IT" => "Italiano",
                                    "en-US" => "Inglese",
                                    "fr-FR" => "Francese",
                                    "es-ES" => "Spagnolo",
                                    _ => guide.LanguageCode
                                };


                            <div class="artwork-inactive-audio-item">

                                <div>

                                    <strong>
                                        @guide.Title
                                    </strong>

                                    <span>
                                        @inactiveLanguageName
                                    </span>

                                </div>


                                <div>

                                    <a asp-controller="ArtworkAudioGuides" asp-action="Edit" asp-route-id="@guide.Id">

                                        Modifica

                                    </a>


                                    <a asp-controller="ArtworkAudioGuides" asp-action="Delete" asp-route-id="@guide.Id" class="text-danger ms-3">

                                        Elimina

                                    </a>

                                </div>

                            </div>
                        }

                    </div>
                }
            }

        </section>
    }


    @* Anteprima dell'opera su una parete ("Visualizza nella tua stanza") *@

    @if (!string.IsNullOrWhiteSpace(artwork.ImageUrl) && artwork.WidthCm.HasValue && artwork.WidthCm.Value > 0 &&
         artwork.HeightCm.HasValue && artwork.HeightCm.Value > 0)
    {
        <partial name="_ArtworkRoomPreview" model="artwork" />
    }


    @* Descrizione dell'opera *@

    @if (!string.IsNullOrWhiteSpace(artwork.Description))
    {
        <section class="artwork-editorial-section">

            <div class="gallery-eyebrow mb-3">
                L'opera
            </div>


            <div class="row">

                <div class="col-lg-4">

                    <h2>
                        Descrizione
                    </h2>

                </div>


                <div class="col-lg-7">

                    <p class="artwork-editorial-text">
                        @artwork.Description
                    </p>

                </div>

            </div>

        </section>
    }


    @* Informazioni sull'artista *@

    @if (artwork.Artist != null)
    {
        <section class="artwork-editorial-section">

            <div class="gallery-eyebrow mb-3">
                L'artista
            </div>


            <div class="row g-5">

                <div class="col-lg-5">

                    <h2 class="artwork-artist-large-title">

                        @artwork.Artist.FirstName
                        @artwork.Artist.LastName

                    </h2>

                </div>


                <div class="col-lg-7">

                    <div class="artwork-artist-data">


                        @if (!string.IsNullOrWhiteSpace(artwork.Artist.Nationality))
                        {
                            <div>

                                <span>
                                    Nazionalità
                                </span>

                                <strong>
                                    @artwork.Artist.Nationality
                                </strong>

                            </div>
                        }


                        @if (artwork.Artist.BirthDate.HasValue)
                        {
                            <div>

                                <span>
                                    Nascita
                                </span>

                                <strong>
                                    @artwork.Artist.BirthDate.Value.ToString("dd/MM/yyyy")
                                </strong>

                            </div>
                        }


                        @if (artwork.Artist.DeathDate.HasValue)
                        {
                            <div>

                                <span>
                                    Morte
                                </span>

                                <strong>
                                    @artwork.Artist.DeathDate.Value.ToString("dd/MM/yyyy")
                                </strong>

                            </div>
                        }

                    </div>


                    @if (!string.IsNullOrWhiteSpace(artwork.Artist.Biography))
                    {
                        <p class="artwork-artist-biography">
                            @artwork.Artist.Biography
                        </p>
                    }

                    <a asp-controller="Artists" asp-action="Details" asp-route-id="@artwork.ArtistId" class="artwork-artist-link">

                        Scopri l'artista →

                    </a>

                </div>

            </div>

        </section>
    }


    @* Altre opere dello stesso artista *@

    @if (Model.RelatedArtworks.Any())
    {
        <section class="related-artworks-section">

            <div class="related-artworks-header">

                <div>

                    <div class="gallery-eyebrow mb-3">
                        Continua a scoprire
                    </div>

                    <h2>

                        Altre opere di
                        @artwork.Artist?.FirstName
                        @artwork.Artist?.LastName

                    </h2>

                </div>


                <a asp-controller="Artists" asp-action="Details" asp-route-id="@artwork.ArtistId" class="artwork-artist-link">

                    Vedi l'artista →

                </a>

            </div>


            <div class="row g-4">

                @foreach (var related in Model.RelatedArtworks)
                {
                    <div class="col-md-4">

                        <article class="related-artwork-card">

                            <a asp-controller="Artworks" asp-action="Details" asp-route-id="@related.Id" class="related-artwork-image-wrapper">

                                @if (!string.IsNullOrWhiteSpace(related.ImageUrl))
                                {
                                    <img src="@related.ImageUrl" alt="@related.Title" class="related-artwork-image" />
                                }
                                else
                                {
                                    <div class="related-artwork-placeholder">

                                        Immagine non disponibile

                                    </div>
                                }

                            </a>


                            <div class="related-artwork-content">

                                <h3>

                                    <a asp-controller="Artworks" asp-action="Details" asp-route-id="@related.Id">

                                        @related.Title

                                    </a>

                                </h3>


                                @if (related.Year.HasValue)
                                {
                                    <span>
                                        @related.Year
                                    </span>
                                }

                            </div>

                        </article>

                    </div>
                }

            </div>

        </section>
    }


    @* QR code dell'opera, solo per Staff e Admin *@

    @if (User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin))
    {
        <section class="artwork-qr-admin-section">

            <div class="gallery-eyebrow mb-3">
                QR dell'opera
            </div>


            <div class="artwork-qr-admin-layout">

                <div class="artwork-qr-image-wrapper">

                    <img src="@Url.Action("Image", "ArtworkQr", new { id = artwork.Id })" alt="QR code per @artwork.Title" 
                    class="artwork-qr-image" />

                </div>


                <div class="artwork-qr-content">

                    <h2>
                        QR code visitatore
                    </h2>

                    <p>
                        Posiziona questo QR accanto all'opera
                        in galleria. Scansionandolo, il visitatore
                        accederà direttamente alla pagina digitale
                        dell'opera e alla relativa audioguida.
                    </p>


                    <div class="artwork-qr-actions">

                        <a asp-controller="ArtworkQr" asp-action="Download" asp-route-id="@artwork.Id" class="btn gallery-btn-primary">

                            Scarica QR

                        </a>

                    </div>

                </div>

            </div>

        </section>
    }

    @* Modifica ed eliminazione dell'opera *@
    @if (User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin))
    {
        <div class="artwork-admin-actions">

            <a asp-controller="Artworks" asp-action="Edit" asp-route-id="@artwork.Id" class="btn gallery-btn-outline">

                Modifica opera

            </a>


            <a asp-controller="Artworks" asp-action="Delete" asp-route-id="@artwork.Id" class="btn gallery-btn-danger">

                Elimina opera

            </a>

        </div>
    }

</div>


@* Script del form e dell'anteprima nella stanza *@
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/artwork-room-preview.js" asp-append-version="true">
    </script>
}