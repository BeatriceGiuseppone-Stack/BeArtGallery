@model BeArtGallery.Models.Artwork

<section class="room-preview-section">

    <div class="row g-5">

        @* =================================================
           COLONNA SINISTRA - SPIEGAZIONE
           ================================================= *@

        <div class="col-lg-4">

            <div class="gallery-eyebrow mb-3">
                Anteprima in ambiente
            </div>

            <h2 class="room-preview-title">
                Visualizza nella tua stanza
            </h2>

            <p class="room-preview-intro">
                Carica una foto della tua parete e scopri
                come potrebbe apparire
                <strong>@Model.Title</strong>
                nel tuo ambiente.
            </p>


            <div class="room-preview-steps">

                <div class="room-preview-step">

                    <span>
                        01
                    </span>

                    <div>

                        <strong>
                            Carica una foto
                        </strong>

                        <p>
                            Puoi scegliere una foto dalla galleria
                            oppure utilizzare la fotocamera del telefono.
                        </p>

                    </div>

                </div>


                <div class="room-preview-step">

                    <span>
                        02
                    </span>

                    <div>

                        <strong>
                            Indica una misura reale
                        </strong>

                        <p>
                            Inserisci la larghezza di un elemento visibile
                            nella foto, ad esempio il divano.
                        </p>

                    </div>

                </div>


                <div class="room-preview-step">

                    <span>
                        03
                    </span>

                    <div>

                        <strong>
                            Seleziona i due estremi
                        </strong>

                        <p>
                            Clicca sulla foto i due punti che delimitano
                            l'oggetto di riferimento.
                        </p>

                    </div>

                </div>

            </div>

        </div>


        @* =================================================
           COLONNA DESTRA - ANTEPRIMA E CONTROLLI
           ================================================= *@

        <div class="col-lg-8">

            <div class="room-preview-right-column">

                @* Anteprima *@

                <div class="room-preview-workspace">

                    <div id="roomPreviewPlaceholder"
                         class="room-preview-placeholder">

                        <div>

                            <span class="room-preview-placeholder-icon">
                                +
                            </span>

                            <strong>
                                Carica la foto della tua stanza
                            </strong>

                            <p>
                                L'anteprima comparirà qui.
                            </p>

                        </div>

                    </div>


                    <canvas id="roomPreviewCanvas"
                            class="room-preview-canvas d-none"
                            data-artwork-image="@Model.ImageUrl"
                            data-artwork-width="@Model.WidthCm"
                            data-artwork-height="@Model.HeightCm"
                            tabindex="0"
                            aria-label="Anteprima dell'opera nella stanza. Usa le frecce per spostare l'opera e i tasti più e meno per ridimensionarla.">
                    </canvas>

                </div>


                @* Legenda *@

                <div class="room-preview-legend">

                    <span>
                        Trascina l'opera per spostarla.
                    </span>

                    <span>
                        Usa il quadratino in basso a destra
                        per ridimensionarla.
                    </span>

                    <span>
                        Da tastiera: frecce per spostarla,
                        + e − per ridimensionarla.
                    </span>

                </div>


                @* =================================================
                   PANNELLO CONTROLLI
                   ================================================= *@

                <div class="room-preview-control-panel">

                    @* Foto della stanza *@

                    <div class="room-preview-photo-control">

                        <label for="roomPhoto"
                               class="form-label gallery-form-label">

                            Foto della stanza

                        </label>

                        <input type="file"
                               id="roomPhoto"
                               accept="image/*"
                               capture="environment"
                               class="form-control gallery-form-control" />

                    </div>


                    @* Modalità anteprima *@

                    <div class="room-preview-mode-section">

                        <div class="room-preview-mode-label">
                            Modalità di visualizzazione
                        </div>

                        <div class="room-preview-mode-switch">

                            <button type="button"
                                    id="freePreviewMode"
                                    aria-pressed="true"
                                    class="room-preview-mode-button active">

                                <span class="room-preview-mode-title">
                                    Anteprima libera
                                </span>

                                <span class="room-preview-mode-description">
                                    Posiziona e ridimensiona liberamente l'opera.
                                </span>

                            </button>


                            <button type="button"
                                    id="realScaleMode"
                                    aria-pressed="false"
                                    class="room-preview-mode-button">

                                <span class="room-preview-mode-title">
                                    Scala reale
                                </span>

                                <span class="room-preview-mode-description">
                                    Calcola la dimensione dell'opera nella stanza.
                                </span>

                            </button>

                        </div>

                    </div>


                    @* Informazione modalità libera *@

                    <div id="freeModeHint"
                         class="room-preview-mode-hint">

                        <strong>
                            Anteprima libera
                        </strong>

                        <p>
                            Dopo aver caricato la foto, trascina l'opera sulla parete
                            e utilizza il quadratino nell'angolo per modificarne
                            liberamente la dimensione.
                        </p>

                    </div>


                    @* Controlli scala reale *@

                    <div id="realScaleControls"
                         class="room-preview-real-scale d-none">

                        <div class="room-preview-real-scale-heading">

                            <div>

                                <span class="gallery-eyebrow">
                                    Calibrazione
                                </span>

                                <h3>
                                    Imposta la scala reale
                                </h3>

                            </div>

                            <p>
                                Usa un elemento della foto di cui conosci
                                la misura reale.
                            </p>

                        </div>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label for="referenceCm"
                                       class="form-label gallery-form-label">

                                    Misura reale di riferimento

                                </label>

                                <div class="room-reference-input">

                                    <input type="number"
                                           id="referenceCm"
                                           min="1"
                                           step="0.1"
                                           class="form-control gallery-form-control"
                                           placeholder="Es. 200" />

                                    <span>
                                        cm
                                    </span>

                                </div>

                                <div class="form-text">
                                    Es. larghezza della parete = 200 cm.
                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="room-preview-reference-example">

                                    <strong>
                                        Come funziona?
                                    </strong>

                                    <p>
                                        Inserisci la misura e poi seleziona
                                        sulla foto i due estremi dell'elemento.
                                    </p>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <button type="button"
                                        id="startCalibration"
                                        class="btn gallery-btn-primary room-preview-action-button">

                                    Seleziona i due estremi

                                </button>

                            </div>


                            <div class="col-md-6">

                                <button type="button"
                                        id="restoreRealScale"
                                        class="btn gallery-btn-outline room-preview-action-button"
                                        disabled>

                                    Ripristina scala reale

                                </button>

                            </div>

                        </div>

                    </div>


                    @* Stato *@

                    <div id="roomPreviewStatus"
                         class="room-preview-status"
                         role="status">

                        Carica una foto per iniziare.

                    </div>


                    @* Privacy *@

                    <div class="room-preview-privacy">

                        <div class="room-preview-privacy-icon"
                             aria-hidden="true">

                            ✓

                        </div>

                        <div>

                            <strong>
                                La tua foto resta privata
                            </strong>

                            <p>
                                L'immagine viene elaborata esclusivamente
                                nel browser e non viene salvata da BeArtGallery.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>