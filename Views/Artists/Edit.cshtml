@model BeArtGallery.Models.Artist

@{
    ViewData["Title"] = "Modifica artista";
}

<div class="container py-5">

    @* Navigazione *@

    <div class="mb-5">

        <a asp-controller="Artists"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="gallery-back-link">

            ← Torna all'artista

        </a>

    </div>


    <div class="row g-5">

        <div class="col-lg-8">

            <div class="gallery-eyebrow mb-3">
                Gestione artisti
            </div>

            <h1 class="gallery-form-title">
                Modifica artista
            </h1>

            <p class="gallery-form-intro">

                Aggiorna le informazioni di
                @Model.FirstName @Model.LastName.

                Le modifiche saranno visibili
                nella scheda pubblica dell'artista
                e nelle opere associate.

            </p>


            <form asp-action="Edit"
                  method="post"
                  class="gallery-form">

                <input type="hidden"
                       asp-for="Id" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <div class="row g-4">


                    @* Nome *@

                    <div class="col-md-6">

                        <label asp-for="FirstName"
                               class="form-label gallery-form-label">

                            Nome

                        </label>

                        <input asp-for="FirstName"
                               class="form-control gallery-form-control"
                               placeholder="Es. Vincent" />

                        <span asp-validation-for="FirstName"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Cognome *@

                    <div class="col-md-6">

                        <label asp-for="LastName"
                               class="form-label gallery-form-label">

                            Cognome

                        </label>

                        <input asp-for="LastName"
                               class="form-control gallery-form-control"
                               placeholder="Es. Van Gogh" />

                        <span asp-validation-for="LastName"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Data di nascita *@

                    <div class="col-md-6">

                        <label asp-for="BirthDate"
                               class="form-label gallery-form-label">

                            Data di nascita

                        </label>

                        <input asp-for="BirthDate"
                               type="date"
                               class="form-control gallery-form-control" />

                        <span asp-validation-for="BirthDate"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Data di morte *@

                    <div class="col-md-6">

                        <label asp-for="DeathDate"
                               class="form-label gallery-form-label">

                            Data di morte

                        </label>

                        <input asp-for="DeathDate"
                               type="date"
                               class="form-control gallery-form-control" />

                        <span asp-validation-for="DeathDate"
                              class="text-danger small">
                        </span>

                        <div class="form-text">

                            Lascia vuoto per artisti viventi.

                        </div>

                    </div>


                    @* Nazionalità *@

                    <div class="col-12">

                        <label asp-for="Nationality"
                               class="form-label gallery-form-label">

                            Nazionalità

                        </label>

                        <input asp-for="Nationality"
                               class="form-control gallery-form-control"
                               placeholder="Es. Olandese" />

                        <span asp-validation-for="Nationality"
                              class="text-danger small">
                        </span>

                    </div>


                    @* Biografia *@

                    <div class="col-12">

                        <label asp-for="Biography"
                               class="form-label gallery-form-label">

                            Biografia

                        </label>

                        <textarea asp-for="Biography"
                                  class="form-control gallery-form-control"
                                  rows="8"
                                  placeholder="Inserisci una breve biografia dell'artista..."></textarea>

                        <span asp-validation-for="Biography"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <div class="gallery-form-actions">

                    <button type="submit"
                            class="btn gallery-btn-primary">

                        Salva modifiche

                    </button>


                    <a asp-controller="Artists"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn gallery-btn-outline">

                        Annulla

                    </a>

                </div>

            </form>

        </div>


        @* Pannello informativo *@

        <div class="col-lg-4 d-none d-lg-block">

            <div class="gallery-form-side">

                <div>

                    <div class="gallery-eyebrow mb-3">
                        Catalogo
                    </div>

                    <h2>
                        @Model.FirstName
                        @Model.LastName
                    </h2>

                    <p>

                        Le informazioni aggiornate
                        saranno utilizzate nella pagina
                        pubblica dell'artista e nelle
                        schede delle opere associate.

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}