@model BeArtGallery.Models.Artist

@{
    ViewData["Title"] = "Elimina artista";
}

<div class="container py-5">

    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="gx-back-link">
        ← Torna all'artista
    </a>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="gx-form-card">

                <div class="gallery-eyebrow mb-2">
                    Artisti
                </div>

                <h1 class="gx-form-title">
                    Eliminare questo artista?
                </h1>

                <p class="gx-page-intro mb-4">
                    La scheda dell'artista verrà rimossa definitivamente.
                    L'operazione non si può annullare.
                </p>

                <dl class="gx-confirm-list">

                    <dt>Nome</dt>
                    <dd>@Model.FirstName @Model.LastName</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.Nationality))
                    {
                        <dt>Nazionalità</dt>
                        <dd>@Model.Nationality</dd>
                    }

                    @if (Model.BirthDate.HasValue)
                    {
                        <dt>Nascita</dt>
                        <dd>@Model.BirthDate.Value.ToString("dd/MM/yyyy")</dd>
                    }

                    @if (Model.DeathDate.HasValue)
                    {
                        <dt>Morte</dt>
                        <dd>@Model.DeathDate.Value.ToString("dd/MM/yyyy")</dd>
                    }

                    <dt>Opere in catalogo</dt>
                    <dd>@Model.Artworks.Count</dd>

                </dl>

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn gallery-btn-danger">
                            Elimina definitivamente
                        </button>

                        <a asp-action="Index"
                           class="btn gallery-btn-outline">
                            Annulla
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
