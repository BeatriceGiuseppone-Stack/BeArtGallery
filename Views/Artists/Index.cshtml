@model IEnumerable<BeArtGallery.Models.Artist>
@using BeArtGallery.Authorization

@* Dati per la paginazione e il contatore "Artisti 1–9 di 20" *@
@{
    ViewData["Title"] = "Artisti";

    var currentPage = ViewBag.Page is int p ? p : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var totalCount = ViewBag.TotalCount is int tc ? tc : Model.Count();
    var pageSize = ViewBag.PageSize is int ps ? ps : 9;

    var firstShown = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var lastShown = (currentPage - 1) * pageSize + Model.Count();
}

<div class="container py-5">

    @* Intestazione della pagina *@

    <div class="gx-band d-flex justify-content-between align-items-end flex-wrap gap-3 mb-5">

        <div>

            <div class="gallery-eyebrow mb-3">
                Il catalogo
            </div>

            <h1 class="artists-page-title">
                I nostri artisti
            </h1>

            <p class="artists-page-intro">
                Scopri gli artisti presenti nella collezione
                di BeArtGallery e le opere che raccontano
                il loro percorso.
            </p>

        </div>


        @* Pulsante "Nuovo artista" solo per Staff e Admin *@
        @if (User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin))
        {
            <a asp-controller="Artists" asp-action="Create" class="btn gallery-btn-primary">

                Nuovo artista

            </a>
        }

    </div>

    @* Nota per lo staff sull'eliminazione degli artisti *@
    @if (User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin))
        {
            <div class="gallery-management-note mb-4">
        
                <div class="gallery-management-note-title">
                    Gestione artisti
                </div>
        
                <p class="mb-0">
                    Un artista può essere eliminato solamente se
                    non ha opere associate nel catalogo.
                    Per questo motivo il pulsante
                    <strong>Elimina</strong> viene mostrato solo
                    quando non sono presenti opere collegate.
                </p>
        
            </div>
        }


    @* Messaggi di conferma o di errore *@

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">

            @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4">

            @TempData["ErrorMessage"]

        </div>
    }


    @* Elenco degli artisti *@

    @* Nessun artista nel catalogo *@
    @if (!Model.Any())
    {
        <div class="artist-empty-state">

            <div class="gallery-eyebrow mb-2">
                Catalogo
            </div>

            <h2>
                Nessun artista presente
            </h2>

            <p>
                Il catalogo degli artisti non contiene
                ancora elementi.
            </p>

        </div>
    }
    else
    {
        <p class="gx-catalog-count">
            Artisti @(firstShown)–@(lastShown) di @totalCount
        </p>

        @* Indice degli artisti: nomi grandi raggruppati per iniziale del cognome.
           Passando con il mouse su un nome compare una sua opera. *@

        <div class="gx-artist-index">

            @* Raggruppa gli artisti per iniziale del cognome *@
            @foreach (var group in Model.GroupBy(a => string.IsNullOrEmpty(a.LastName) ? "#"
                    : a.LastName.Substring(0, 1).ToUpperInvariant()))
            {
                <section class="gx-artist-group" aria-labelledby="lettera-@group.Key">

                    <h2 class="gx-artist-letter" id="lettera-@group.Key">
                        @group.Key
                    </h2>

                    <ol class="gx-artist-list">

                        @* Una riga per ogni artista *@
                        @foreach (var artist in group)
                        {
                            var cover = artist.Artworks.Where(w => !string.IsNullOrWhiteSpace(w.ImageUrl))
                                .OrderBy(w => w.Id).FirstOrDefault();

                            var worksCount = artist.Artworks.Count;

                            <li class="gx-artist-row @(cover != null ? "has-preview" : "")">

                                <div class="gx-artist-main">

                                    <h3 class="gx-artist-name">

                                        <a asp-controller="Artists" asp-action="Details" asp-route-id="@artist.Id" class="gx-artist-link">

                                            <span class="gx-artist-first">@artist.FirstName</span>
                                            <span class="gx-artist-last">@artist.LastName</span>

                                        </a>

                                    </h3>

                                    <p class="gx-artist-meta">

                                        @* Nazionalità e anni *@
                                        @if (!string.IsNullOrWhiteSpace(artist.Nationality))
                                        {
                                            <span>@artist.Nationality</span>
                                        }

                                        @if (artist.BirthDate.HasValue)
                                        {
                                            <span>
                                                @(artist.DeathDate.HasValue
                                                    ? $"{artist.BirthDate.Value.Year}–{artist.DeathDate.Value.Year}"
                                                    : $"n. {artist.BirthDate.Value.Year}")
                                            </span>
                                        }

                                    </p>

                                </div>


                                @* Numero di opere e pulsanti per lo staff *@
                                <div class="gx-artist-side">

                                    <span class="gx-artist-count">
                                        @(worksCount == 0 ? "Opere in arrivo"
                                            : worksCount == 1 ? "1 opera"
                                                : $"{worksCount} opere")
                                    </span>


                                    @if (User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin))
                                    {
                                        <div class="gx-artist-admin">

                                            <a asp-controller="Artists" asp-action="Edit" asp-route-id="@artist.Id"
                                               class="btn btn-sm gallery-btn-outline">

                                                Modifica
                                                <span class="visually-hidden">
                                                    @artist.FirstName @artist.LastName
                                                </span>

                                            </a>

                                            @* Si può eliminare solo un artista senza opere *@
                                            @if (!artist.Artworks.Any())
                                            {
                                                <a asp-controller="Artists" asp-action="Delete" asp-route-id="@artist.Id"
                                                   class="btn btn-sm gallery-btn-danger">

                                                    Elimina
                                                    <span class="visually-hidden">
                                                        @artist.FirstName @artist.LastName
                                                    </span>

                                                </a>
                                            }

                                        </div>
                                    }

                                </div>

                                @if (cover != null)
                                {
                                    @* Anteprima di un'opera, solo decorativa: il link vero è il nome *@

                                    <figure class="gx-artist-preview" aria-hidden="true">

                                        <img src="@cover.ImageUrl" alt="" loading="lazy" />

                                        <figcaption>
                                            @(cover.Year.HasValue ? $"{cover.Title}, {cover.Year}" : cover.Title)
                                        </figcaption>

                                    </figure>
                                }

                            </li>
                        }

                    </ol>

                </section>
            }

        </div>

        @* Barra delle pagine (9 artisti per pagina) *@

        @(await Html.PartialAsync("_Pagination", new BeArtGallery.ViewModels.PaginationViewModel
            {
                CurrentPage = currentPage,
                TotalPages = totalPages,
                Controller = "Artists",
                AriaLabel = "Pagine degli artisti"
            }))
    }

</div>