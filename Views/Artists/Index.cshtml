@model IEnumerable<BeArtGallery.Models.Artist>
@using BeArtGallery.Authorization

@{
    ViewData["Title"] = "Artisti";

    var currentPage = ViewBag.Page is int p ? p : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var totalCount = ViewBag.TotalCount is int tc ? tc : Model.Count();
    var pageSize = ViewBag.PageSize is int ps ? ps : 9;

    var firstShown = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var lastShown = (currentPage - 1) * pageSize + Model.Count();
}

<div class="container py-5">

    @* Intestazione della pagina *@

    <div class="gx-band d-flex justify-content-between
                align-items-end
                flex-wrap
                gap-3
                mb-5">

        <div>

            <div class="gallery-eyebrow mb-3">
                Il catalogo
            </div>

            <h1 class="artists-page-title">
                I nostri artisti
            </h1>

            <p class="artists-page-intro">
                Scopri gli artisti presenti nella collezione
                di BeArtGallery e le opere che raccontano
                il loro percorso.
            </p>

        </div>


        @if (User.IsInRole(RoleNames.Staff) ||
             User.IsInRole(RoleNames.Admin))
        {
            <a asp-controller="Artists"
               asp-action="Create"
               class="btn gallery-btn-primary">

                Nuovo artista

            </a>
        }

    </div>


    @if (User.IsInRole(RoleNames.Staff) ||
     User.IsInRole(RoleNames.Admin))
{
    <div class="gallery-management-note mb-4">

        <div class="gallery-management-note-title">
            Gestione artisti
        </div>

        <p class="mb-0">
            Un artista può essere eliminato solamente se
            non ha opere associate nel catalogo.
            Per questo motivo il pulsante
            <strong>Elimina</strong> viene mostrato solo
            quando non sono presenti opere collegate.
        </p>

    </div>
}


    @* Messaggi *@

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">

            @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4">

            @TempData["ErrorMessage"]

        </div>
    }


    @* Elenco degli artisti *@

    @if (!Model.Any())
    {
        <div class="artist-empty-state">

            <div class="gallery-eyebrow mb-2">
                Catalogo
            </div>

            <h2>
                Nessun artista presente
            </h2>

            <p>
                Il catalogo degli artisti non contiene
                ancora elementi.
            </p>

        </div>
    }
    else
    {
        <p class="gx-catalog-count">
            Artisti @(firstShown)–@(lastShown) di @totalCount
        </p>

        <div class="row g-4">

            @foreach (var artist in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <article class="artist-card">

                        @* Monogramma dell'artista *@

                        <a asp-controller="Artists"
                           asp-action="Details"
                           asp-route-id="@artist.Id"
                           class="artist-card-visual">

                            <span>
                                @artist.FirstName.FirstOrDefault()
                            </span>

                            <strong>
                                @artist.LastName.FirstOrDefault()
                            </strong>

                        </a>


                        <div class="artist-card-body">

                            <div class="gallery-eyebrow mb-2">
                                Artista
                            </div>


                            <h2 class="artist-card-title">

                                <a asp-controller="Artists"
                                   asp-action="Details"
                                   asp-route-id="@artist.Id">

                                    @artist.FirstName
                                    @artist.LastName

                                </a>

                            </h2>


                            @if (!string.IsNullOrWhiteSpace(
                                artist.Nationality))
                            {
                                <div class="artist-card-nationality">

                                    @artist.Nationality

                                </div>
                            }


                            <div class="artist-card-meta">

                                @if (artist.BirthDate.HasValue)
                                {
                                    <span>

                                        @artist.BirthDate.Value.Year

                                        @if (artist.DeathDate.HasValue)
                                        {
                                            <text>
                                                –
                                                @artist.DeathDate.Value.Year
                                            </text>
                                        }

                                    </span>
                                }


                                <span>

                                    @artist.Artworks.Count
                                    @(artist.Artworks.Count == 1
                                        ? "opera"
                                        : "opere")

                                </span>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                artist.Biography))
                            {
                                <p class="artist-card-biography">

                                    @artist.Biography

                                </p>
                            }


                            <div class="artist-card-actions">

                                <a asp-controller="Artists"
                                   asp-action="Details"
                                   asp-route-id="@artist.Id"
                                   class="artist-card-link">

                                    Scopri l'artista →

                                </a>


                                @if (User.IsInRole(RoleNames.Staff) ||
                                     User.IsInRole(RoleNames.Admin))
                                {
                                    <div class="artist-card-admin-actions">

                                        <a asp-controller="Artists"
                                           asp-action="Edit"
                                           asp-route-id="@artist.Id"
                                           class="btn btn-sm gallery-btn-outline">

                                            Modifica

                                        </a>


                                        @if (!artist.Artworks.Any())
                                        {
                                            <a asp-controller="Artists"
                                               asp-action="Delete"
                                               asp-route-id="@artist.Id"
                                               class="btn btn-sm gallery-btn-danger">

                                                Elimina

                                            </a>
                                        }

                                    </div>
                                }

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>

        @* Paginazione: 9 artisti per pagina *@

        @(await Html.PartialAsync("_Pagination",
            new BeArtGallery.ViewModels.PaginationViewModel
            {
                CurrentPage = currentPage,
                TotalPages = totalPages,
                Controller = "Artists",
                AriaLabel = "Pagine degli artisti"
            }))
    }

</div>