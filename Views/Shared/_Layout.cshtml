@* Layout comune a tutte le pagine: menu in alto, contenuto e piè di pagina *@
@using BeArtGallery.Authorization

<!DOCTYPE html>

<html lang="it">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - BeArtGallery
    </title>

    <script type="importmap"></script>


    @* Fogli di stile: Bootstrap, stile del sito e tema della galleria *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Tema della galleria (colori, caratteri, effetti) *@
    <link rel="stylesheet" href="~/css/gallery-experience.css" asp-append-version="true" />

    @* Stili aggiuntivi delle singole pagine *@
    @await RenderSectionAsync("Styles", required: false)

    <link rel="stylesheet" href="~/BeArtGallery.styles.css" asp-append-version="true" />

</head>

<body>

    @* Link per chi usa la tastiera: salta il menu e va al contenuto *@
    <a class="gx-skip-link" href="#main-content">Vai al contenuto</a>

    <header>

        <nav class="navbar navbar-expand-lg gallery-navbar">

            <div class="container">

                @* Logo che riporta alla home *@

                <a class="navbar-brand gallery-brand" asp-area="" asp-controller="Home" asp-action="Index"
                   aria-label="BeArtGallery - Home">

                    <img src="~/images/beartgallery-logo-horizontal.png" alt="BeArtGallery" class="gallery-brand-logo" />

                </a>

                @* Pulsante del menu su smartphone *@

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Apri il menu di navigazione">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    @* Menu principale *@

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gallery-main-nav">

                        @* Home *@

                        <li class="nav-item">

                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">

                                Home

                            </a>

                        </li>

                        @* Artisti *@

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Artists" asp-action="Index">

                                Artisti

                            </a>

                        </li>

                        @* Opere *@

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Artworks" asp-action="Index">

                                Opere

                            </a>

                        </li>

                        @* Eventi *@

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="GalleryActivities" asp-action="Index">

                                Eventi

                            </a>

                        </li>

                        @* Chi siamo *@

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Home" asp-action="About">

                                Chi siamo

                            </a>

                        </li>

                        @* Menu "Gestione": solo per Staff e Admin *@

                        @if (User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">

                                    Gestione

                                </a>
                                 
                                <ul class="dropdown-menu gallery-dropdown">
                                     
                                    @* Dashboard *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">

                                            Dashboard

                                        </a>

                                    </li> 

                                    <li>

                                        <hr class="dropdown-divider" />

                                    </li>

                                    @* Artisti *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Artists" asp-action="Index">

                                            Artisti

                                        </a>

                                    </li> 

                                    @* Prenotazioni *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Bookings" asp-action="Manage">

                                            Prenotazioni

                                        </a>

                                    </li> 

                                    @* Richieste informazioni *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="ArtworkInquiries" asp-action="Index">

                                            Richieste informazioni

                                        </a>

                                    </li>
                                     
                                    @* Feedback visitatori *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Feedback" asp-action="Index">

                                            Feedback visitatori

                                        </a>

                                    </li>
                                     
                                    @* Gestione utenti: solo per Admin *@

                                    @if (User.IsInRole(RoleNames.Admin))
                                    {
                                        <li>

                                            <hr class="dropdown-divider" />

                                        </li>


                                        <li>

                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Users">

                                                Utenti

                                            </a>

                                        </li>
                                    }

                                </ul>

                            </li>
                        }

                    </ul>
                     
                    @* Menu dell'account *@

                    <div class="gallery-account">

                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            @* Utente che ha fatto l'accesso *@

                            <ul class="navbar-nav gallery-user-nav">

                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle gallery-account-toggle" href="#"
                                       id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">

                                        Area personale
                                         
                                        @* Numero di risposte non lette (solo per i visitatori) *@
                                        @if (User.IsInRole(RoleNames.Visitore))
                                        {
                                            @await Component.InvokeAsync("InquiryNotificationCount")
                                        }

                                    </a>


                                    <ul class="dropdown-menu dropdown-menu-end gallery-dropdown gallery-account-menu"
                                        aria-labelledby="accountDropdown">

                                        @* Pagine del visitatore: prenotazioni, preferiti e richieste *@

                                        @if (User.IsInRole(RoleNames.Visitore))
                                        {

                                            <li>

                                                <a class="dropdown-item" asp-controller="Bookings" asp-action="Index">

                                                    Le mie prenotazioni

                                                </a>

                                            </li>

                                            <li>

                                                <a class="dropdown-item" asp-controller="Artworks" asp-action="Favorites">

                                                    I miei preferiti

                                                </a>

                                            </li>
                                             
                                            <li>

                                                <a class="dropdown-item gallery-nav-notification" asp-controller="MyInquiries" asp-action="Index">

                                                    <span>
                                                        Le mie richieste
                                                    </span>

                                                    @await Component.InvokeAsync("InquiryNotificationCount")

                                                </a>

                                            </li>

                                            <li>

                                                <hr class="dropdown-divider" />

                                            </li>
                                        }

                                        @* Profilo dell'utente *@

                                        <li>

                                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">

                                                Il mio profilo

                                            </a>

                                        </li>

                                        <li>

                                            <hr class="dropdown-divider" />

                                        </li>

                                        @* Uscita (logout) *@

                                        <li>

                                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")"
                                                  method="post" class="m-0">

                                                <button type="submit" class="dropdown-item gallery-logout-link">

                                                    Esci

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </li>

                            </ul>

                        }
                        else
                        {

                            @* Utente senza accesso: registrazione e login *@

                            <ul class="navbar-nav gallery-user-nav">

                                <li class="nav-item">

                                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">

                                        Registrati

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">

                                        Accedi

                                    </a>

                                </li>

                            </ul>

                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    @* Contenuto della pagina *@

    <main role="main" id="main-content" tabindex="-1">

        @RenderBody()

    </main>

    @* Footer *@

    <footer class="gallery-footer">

        <div class="container">

            <div class="row gy-4 align-items-start">

                @* Nome e descrizione della galleria *@

                <div class="col-md-5">

                    <div class="gallery-footer-brand">
                        BeArtGallery
                    </div>

                    <p class="gallery-footer-text">

                        Arte, eventi ed esperienze culturali
                        in un unico spazio digitale.

                    </p>

                </div>

                @* Link alle sezioni principali *@

                <div class="col-md-3">

                    <div class="gallery-footer-title">
                        Esplora
                    </div>

                    <a asp-controller="Artists" asp-action="Index">

                        Artisti

                    </a>

                    <a asp-controller="Artworks" asp-action="Index">

                        Opere

                    </a>

                    <a asp-controller="GalleryActivities" asp-action="Index">

                        Eventi

                    </a>

                    <a asp-controller="Home" asp-action="About">

                        Chi siamo

                    </a>

                </div>

                @* Altre informazioni *@

                <div class="col-md-4">

                    <div class="gallery-footer-title">
                        Informazioni
                    </div>
                     
                    <a asp-controller="Home" asp-action="Privacy">

                        Privacy

                    </a>

                </div>

            </div>

            <div class="gallery-footer-bottom">

                © 2026 BeArtGallery

            </div>

        </div>

    </footer>

    @* Script: jQuery, Bootstrap, script del sito e effetti della galleria *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/gallery-experience.js" asp-append-version="true"></script>

    @* Script aggiuntivi delle singole pagine *@
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>