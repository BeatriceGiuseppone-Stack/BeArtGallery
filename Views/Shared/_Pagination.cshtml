@model BeArtGallery.ViewModels.PaginationViewModel

@* Barra delle pagine usata dal catalogo delle opere e dagli artisti.
   Compare solo se ci sono almeno due pagine. *@

@if (Model.TotalPages > 1)
{
    <nav class="gx-pagination" aria-label="@Model.AriaLabel">

        @* Link alla pagina precedente (disattivato sulla prima) *@
        @if (Model.CurrentPage > 1)
        {
            <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-page="@(Model.CurrentPage - 1)"
               class="gx-page-step" rel="prev">
                ← Precedente
            </a>
        }
        else
        {
            <span class="gx-page-step is-disabled" aria-hidden="true">
                ← Precedente
            </span>
        }

        <ol class="gx-page-numbers">

            @* Numeri delle pagine: quella attuale non è un link *@
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li>
                    @if (i == Model.CurrentPage)
                    {
                        <span class="gx-page-number is-current" aria-current="page">
                            <span class="visually-hidden">Pagina </span>@i
                        </span>
                    }
                    else
                    {
                        <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-page="@i" class="gx-page-number">
                            <span class="visually-hidden">Pagina </span>@i
                        </a>
                    }
                </li>
            }

        </ol>

        @* Link alla pagina successiva (disattivato sull'ultima) *@
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-page="@(Model.CurrentPage + 1)" class="gx-page-step"
               rel="next">
                Successiva →
            </a>
        }
        else
        {
            <span class="gx-page-step is-disabled" aria-hidden="true">
                Successiva →
            </span>
        }

    </nav>
}