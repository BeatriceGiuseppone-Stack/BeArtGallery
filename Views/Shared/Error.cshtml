@model ErrorViewModel

@{
    ViewData["Title"] = "Errore";
}

<div class="container py-5">

    @* Pagina di errore generica *@
    <div class="gx-prose">

        <div class="gallery-eyebrow mb-2">
            Qualcosa non ha funzionato
        </div>

        <h1 class="gx-page-title">
            Non siamo riusciti a completare la richiesta
        </h1>

        <p>
            Si è verificato un errore imprevisto. Riprova tra qualche istante;
            se il problema continua, contatta lo staff della galleria.
        </p>

        @* Codice della richiesta, utile per cercare l'errore nei log *@
        @if (Model.ShowRequestId)
        {
            <p class="gx-notice-meta">
                Codice della richiesta: <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn gallery-btn-primary mt-3">
            Torna alla home
        </a>

    </div>

</div>