@model IEnumerable<BeArtGallery.ViewModels.MyBookingViewModel>
@using System.Globalization
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = "Le mie prenotazioni";

    @* Date scritte in italiano (es. "14 novembre", "venerdì") *@
    var it = new CultureInfo("it-IT");
}


@* Stili del QR e del check-in *@
@section Styles
{
    <link rel="stylesheet" href="~/css/booking-qr.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="container py-5">

    @* Intestazione della pagina *@
    <div class="gx-page-head">

        <div>

            <div class="gallery-eyebrow mb-2">
                Area personale
            </div>

            <h1 class="gx-page-title">
                Le mie prenotazioni
            </h1>

            <p class="gx-page-intro">
                I tuoi biglietti per gli eventi della galleria. Il giorno della visita
                mostra il QR code all'ingresso.
            </p>

        </div>

        <div class="gx-page-actions">

            <a asp-controller="GalleryActivities" asp-action="Index" class="btn gallery-btn-outline">

                Prenota un altro evento

            </a>

        </div>

    </div>
     
    @* Messaggi di conferma o di errore *@
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
     
    @* Nessuna prenotazione *@
    @if (!Model.Any())
    {
        <div class="gx-empty">

            <h2>
                Non hai ancora effettuato prenotazioni
            </h2>

            <p>
                Consulta gli eventi in programma
                e scegli quello a cui vuoi partecipare.
            </p>

            <a asp-controller="GalleryActivities" asp-action="Index" class="btn gallery-btn-primary">

                Scopri gli eventi

            </a>

        </div>
    }
    else
    {
        <div class="gx-tickets">

            @* Ogni prenotazione è mostrata come un biglietto *@
            @foreach (var booking in Model)
            {
                var isCancelled = booking.Status == BookingStatus.Cancelled;
                var isUsed = !isCancelled && booking.CheckedInAt.HasValue;

                <article class="gx-ticket @(isCancelled ? "is-void" : "") @(isUsed ? "is-used" : "")">

                    @* Parte sinistra del biglietto con la data *@

                    <div class="gx-ticket-stub" aria-hidden="true">

                        <span class="gx-event-day">@booking.StartDateTime.ToString("dd", it)</span>

                        <span class="gx-event-month">@booking.StartDateTime.ToString("MMMM", it)</span>

                        <span class="gx-event-time">
                            @booking.StartDateTime.ToString("dddd", it)<br />
                            ore @booking.StartDateTime.ToString("HH:mm", it)
                        </span>

                    </div>


                    <div class="gx-ticket-body">

                        @* Tipo di attività e stato della prenotazione *@

                        <div class="gx-event-tags">

                            @if (booking.ActivityType == ActivityType.Visita)
                            {
                                <span class="gx-tag">Visita guidata</span>
                            }
                            else
                            {
                                <span class="gx-tag">Evento</span>
                            }

                            @if (isCancelled)
                            {
                                <span class="gx-tag gx-tag-alert">Annullata</span>
                            }
                            else if (isUsed)
                            {
                                <span class="gx-tag gx-tag-ok">Ingresso registrato</span>
                            }
                            else
                            {
                                <span class="gx-tag gx-tag-ok">Confermata</span>
                            }

                        </div>

                        <h2 class="gx-ticket-title">
                            @booking.ActivityTitle
                        </h2>

                        @* Data, ora, luogo e partecipanti *@

                        <dl class="gx-event-facts">

                            <div>
                                <dt>Data</dt>
                                <dd>@booking.StartDateTime.ToString("dd/MM/yyyy", it), ore @booking.StartDateTime.ToString("HH:mm", it)</dd>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(booking.Location))
                            {
                                <div>
                                    <dt>Luogo</dt>
                                    <dd>@booking.Location</dd>
                                </div>
                            }

                            <div>
                                <dt>Partecipanti</dt>
                                <dd>@booking.NumberOfParticipants</dd>
                            </div>

                            <div>
                                <dt>Prenotata il</dt>
                                <dd>@(booking.BookingDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm", it))</dd>
                            </div>

                        </dl>

                        @* Prenotazione annullata: chi l'ha annullata e perché *@

                        @if (isCancelled)
                        {
                            var cancelledAtText = booking.CancelledAt.HasValue
                                ? booking.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", it) : null;

                            @if (booking.CancellationType == BookingCancellationType.User)
                            {
                                <div class="gx-notice">

                                    <strong>Prenotazione annullata da te.</strong>

                                    @if (cancelledAtText != null)
                                    {
                                        <span class="gx-notice-meta">Annullata il @cancelledAtText</span>
                                    }

                                </div>
                            }
                            else if (booking.CancellationType == BookingCancellationType.StaffOrAdmin)
                            {
                                <div class="gx-notice gx-notice-warn">

                                    <strong>Prenotazione annullata dalla galleria.</strong>

                                    @if (!string.IsNullOrWhiteSpace(booking.CancellationReason))
                                    {
                                        <span>Motivo: @booking.CancellationReason</span>
                                    }

                                    @if (cancelledAtText != null)
                                    {
                                        <span class="gx-notice-meta">Annullata il @cancelledAtText</span>
                                    }

                                </div>
                            }
                            else if (booking.CancellationType == BookingCancellationType.ActivityCancelled)
                            {
                                <div class="gx-notice gx-notice-alert">

                                    <strong>Attività annullata dalla galleria.</strong>

                                    <span>
                                        La tua prenotazione è stata annullata automaticamente
                                        perché l'evento non avrà luogo.
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(booking.CancellationReason))
                                    {
                                        <span>Motivo: @booking.CancellationReason</span>
                                    }

                                    @if (cancelledAtText != null)
                                    {
                                        <span class="gx-notice-meta">Annullata il @cancelledAtText</span>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="gx-notice">
                                    <strong>Prenotazione annullata.</strong>
                                </div>
                            }
                        }

                        @* Biglietto digitale con il QR *@

                        @if (booking.Status == BookingStatus.Confirmed)
                        {
                            @if (booking.CheckedInAt.HasValue)
                            {
                                @* Check-in già fatto *@

                                <div class="booking-checkin-completed">

                                    <div class="booking-checkin-icon"
                                         aria-hidden="true">
                                        ✓
                                    </div>

                                    <div>

                                        <div class="booking-checkin-title">
                                            Ingresso registrato
                                        </div>

                                        <div class="booking-checkin-date">
                                            Check-in effettuato il
                                            <strong>
                                                @(booking.CheckedInAt.Value.ToLocalTime().ToString("dd/MM/yyyy 'alle' HH:mm", it))
                                            </strong>
                                        </div>

                                    </div>

                                </div>

                                @* Feedback sulla visita: si può lasciare dopo il check-in *@

                                <div class="booking-feedback">

                                    @if (booking.HasFeedback)
                                    {
                                        <span class="booking-feedback-done">
                                            La tua valutazione:
                                            <span class="feedback-stars"
                                                  aria-label="@booking.FeedbackRating su 5">
                                                @(new string('★', booking.FeedbackRating ?? 0))@(new string('☆', 5 - (booking.FeedbackRating ?? 0)))
                                            </span>
                                        </span>
                                    }
                                    else if (booking.CanLeaveFeedback)
                                    {
                                        <a asp-controller="Feedback" asp-action="Create" asp-route-bookingId="@booking.BookingId"
                                           class="btn gallery-btn-outline btn-sm">
                                            Lascia un feedback
                                        </a>
                                    }

                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(booking.QrToken))
                            {
                                @* QR da mostrare all'ingresso *@

                                <div class="booking-qr-section">

                                    <div class="booking-qr-content">

                                        <div class="booking-qr-wrapper">

                                            <img src="@Url.Action("Image", "BookingQr", new { id = booking.BookingId })"
                                                 alt="QR code della prenotazione per @booking.ActivityTitle" class="booking-qr-image" />

                                        </div>

                                        <div class="booking-qr-heading">

                                            <h3 class="booking-qr-title">
                                                Il tuo QR di ingresso
                                            </h3>

                                            <p class="booking-qr-description">
                                                Mostra questo codice allo staff al momento
                                                dell'ingresso. Vale per
                                                @booking.NumberOfParticipants
                                                @(booking.NumberOfParticipants == 1 ? "persona" : "persone").
                                            </p>

                                            <p class="booking-qr-notice">
                                                Il QR è personale e associato
                                                alla tua prenotazione.
                                            </p>

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                         
                        @* Pulsante per annullare la prenotazione *@

                        @if (booking.CanCancel)
                        {
                            <div class="booking-actions">

                                <button type="button" class="gx-link-danger cancel-booking-btn" data-booking-id="@booking.BookingId">

                                    Annulla prenotazione

                                </button>

                            </div>
                        }

                    </div>

                </article>
            }

        </div>
    }

</div>
 
@* Script per annullare una prenotazione tramite l'API *@
@section Scripts
{
    <script>

        document.addEventListener( "DOMContentLoaded",
            function () {

                // Pulsanti "Annulla prenotazione"
                const buttons = document.querySelectorAll(".cancel-booking-btn");

                // Token anti-falsificazione da inviare con la richiesta
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                 
                if (!tokenInput) {
                    return;
                }
                 
                const token = tokenInput.value;
                 
                buttons.forEach(
                    function (button) {

                        button.addEventListener("click",
                            async function () {

                                const bookingId = button.dataset.bookingId;
                                 
                                // Chiede conferma prima di annullare
                                const confirmed = confirm("Sei sicuro di voler annullare questa prenotazione?");
                                 
                                if (!confirmed) {
                                    return;
                                }
                                 
                                button.disabled = true;

                                button.textContent = "Annullamento...";

                                try {

                                    // Chiama l'API POST /api/bookings/{id}/cancel
                                    const response = await fetch(
                                            `/api/bookings/${bookingId}/cancel`,
                                            {
                                                method:
                                                    "POST",

                                                headers:
                                                {
                                                    "RequestVerificationToken":
                                                        token
                                                }
                                            });

                                    const data = await response.json();

                                    // In caso di errore mostra il messaggio e riattiva il pulsante
                                    if (!response.ok) {
                                        
                                        alert(data.message ?? "Non è stato possibile annullare la prenotazione.");
 
                                        button.disabled = false;
                                         
                                        button.textContent = "Annulla prenotazione";
                                         
                                        return;
                                    }
                                     
                                    // Annullamento riuscito: ricarica la pagina
                                    window.location.reload();

                                }
                                catch (error) {
                                    console.error("Errore durante l'annullamento:", error);
                                     
                                    alert("Si è verificato un errore durante l'annullamento della prenotazione.");
                                     
                                    button.disabled = false;
                                     
                                    button.textContent = "Annulla prenotazione";
                                }

                            });

                    });

            });

    </script>
}