@model BeArtGallery.ViewModels.BookingManagementPageViewModel
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = "Gestione prenotazioni";
}

<div class="container py-5 gx-manage">

    <!-- INTESTAZIONE -->
    <div class="gx-page-head">

        <div>

        <div class="gallery-eyebrow mb-2">
            Area staff
        </div>

        <h1 class="gx-page-title">
            Gestione prenotazioni
        </h1>

        <p class="gx-page-intro">
            Visualizza e filtra le prenotazioni ricevute
            per gli eventi.
        </p>

        </div>

    </div>

    <!-- MESSAGGI -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- FILTRI -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Bookings"
                  asp-action="Manage"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- ATTIVITÀ -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label" for="filter-activityId">
                            Attività
                        </label>

                        <select id="filter-activityId" name="activityId"
                                class="form-select">

                            <option value="">
                                Tutte le attività
                            </option>

                            @foreach (var activity in Model.Activities)
                            {
                                if (Model.ActivityId == activity.Id)
                                {
                                    <option value="@activity.Id"
                                            selected>
                                        @activity.Title
                                    </option>
                                }
                                else
                                {
                                    <option value="@activity.Id">
                                        @activity.Title
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- STATO -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label" for="filter-status">
                            Stato
                        </label>

                        <select id="filter-status" name="status"
                                class="form-select">

                            <option value="">
                                Tutti
                            </option>

                            @if (Model.Status == BookingStatus.Confirmed)
                            {
                                <option value="@BookingStatus.Confirmed"
                                        selected>
                                    Confermata
                                </option>
                            }
                            else
                            {
                                <option value="@BookingStatus.Confirmed">
                                    Confermata
                                </option>
                            }

                            @if (Model.Status == BookingStatus.Cancelled)
                            {
                                <option value="@BookingStatus.Cancelled"
                                        selected>
                                    Annullata
                                </option>
                            }
                            else
                            {
                                <option value="@BookingStatus.Cancelled">
                                    Annullata
                                </option>
                            }

                        </select>

                    </div>

                    <!-- DATA DA -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label" for="filter-fromDate">
                            Dal
                        </label>

                        <input type="date" id="filter-fromDate" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />

                    </div>

                    <!-- DATA A -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label" for="filter-toDate">
                            Al
                        </label>

                        <input type="date" id="filter-toDate" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />

                    </div>

                    <!-- EMAIL VISITATORE -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label" for="filter-userEmail">
                            Email visitatore
                        </label>

                        <input type="text" id="filter-userEmail" name="userEmail" value="@Model.UserEmail" class="form-control" placeholder="Cerca per email..." />

                    </div>

                    <!-- PULSANTI FILTRI -->
                    <div class="col-12">

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn gallery-btn-primary">
                                Filtra
                            </button>

                            <a asp-controller="Bookings"
                               asp-action="Manage"
                               class="btn gallery-btn-outline">
                                Azzera filtri
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- RISULTATI -->
    @if (!Model.Bookings.Any())
    {
        <div class="alert alert-light border">

            <strong>
                Nessuna prenotazione trovata.
            </strong>

            <div class="text-muted mt-1">
                Non ci sono prenotazioni che corrispondono
                ai filtri selezionati.
            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">
                                    Utente
                                </th>

                                <th>
                                    Attività
                                </th>

                                <th>
                                    Data attività
                                </th>

                                <th class="text-center">
                                    Partecipanti
                                </th>

                                <th>
                                    Prenotata il
                                </th>

                                <th>
                                    Stato
                                </th>

                                <th class="pe-4">
                                    Azioni
                                </th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var booking in Model.Bookings)
                            {
                                <tr>
                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @booking.UserEmail
                                        </div>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @booking.ActivityTitle
                                        </div>

                                        <small class="text-muted">
                                            @if (booking.ActivityType == ActivityType.Visita)
                                            {
                                                <span>Visita</span>
                                            }
                                            else
                                            {
                                                <span>Evento</span>
                                            }
                                        </small>

                                        @if (!string.IsNullOrWhiteSpace(
                                            booking.Location))
                                        {
                                            <div>
                                                <small class="text-muted">
                                                    @booking.Location
                                                </small>
                                            </div>
                                        }

                                    </td>

                                    <td>

                                        <div>
                                            @booking.StartDateTime.ToString("dd/MM/yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @booking.StartDateTime.ToString("HH:mm")
                                        </small>

                                    </td>

                                    <td class="text-center">
                                        @booking.NumberOfParticipants
                                    </td>

                                    <td>
                                        @booking.BookingDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (booking.Status == BookingStatus.Confirmed)
                                        {
                                            <span class="gx-tag gx-tag-ok">
                                                Confermata
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="gx-tag gx-tag-alert">
                                                Annullata
                                            </span>
                                        }
                                    </td>

                                    <td class="pe-4">

                                        @if (booking.Status == BookingStatus.Confirmed &&
                                             booking.StartDateTime > DateTime.Now)
                                        {
                                            <a asp-controller="Bookings"
                                               asp-action="CancelByStaff"
                                               asp-route-id="@booking.BookingId"
                                               class="gx-link-danger">
                                                Annulla
                                            </a>
                                        }
                                        else if (booking.Status == BookingStatus.Cancelled)
                                        {
                                            <span class="text-muted small">
                                                Nessuna azione
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Attività conclusa
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>