@model BeArtGallery.ViewModels.StaffCancelBookingViewModel

@{
    ViewData["Title"] = "Annulla prenotazione";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-action="Manage"
           class="gx-back-link">
            ← Torna alla gestione prenotazioni
        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="gx-form-card">

                <div>

                    <div class="gallery-eyebrow mb-2">
                        Gestione prenotazioni
                    </div>

                    <h1 class="gx-form-title">
                        Annulla prenotazione
                    </h1>

                    <div class="gx-notice mb-4">

                        <div>
                            <strong>Utente:</strong>
                            @Model.UserEmail
                        </div>

                        <div>
                            <strong>Attività:</strong>
                            @Model.ActivityTitle
                        </div>

                        <div>
                            <strong>Data:</strong>
                            @Model.StartDateTime.ToString("dd/MM/yyyy HH:mm")
                        </div>

                    </div>

                    <form asp-action="CancelByStaff"
                          method="post">

                        <input asp-for="BookingId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label asp-for="CancellationReason"
                                   class="form-label">
                            </label>

                            <textarea asp-for="CancellationReason"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Es. annullamento richiesto telefonicamente dal visitatore">
                            </textarea>

                            <span asp-validation-for="CancellationReason"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn gallery-btn-danger">
                                Conferma annullamento
                            </button>

                            <a asp-action="Manage"
                               class="btn gallery-btn-outline">
                                Annulla
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}