@model BeArtGallery.ViewModels.ArtworkAudioGuideViewModel

@{
    ViewData["Title"] = "Aggiungi audioguida";
}


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">


            <div class="gallery-eyebrow mb-3">
                Gestione audioguida
            </div>


            <h1 class="display-5 mb-3">
                Aggiungi audioguida
            </h1>


            <p class="text-muted mb-5">

                Aggiungi un contenuto audio per

                <strong>
                    @ViewBag.ArtworkTitle
                </strong>.

            </p>


            @* Form per una nuova audioguida (con caricamento del file audio) *@
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                @* Id dell'opera (nascosto) *@
                <input asp-for="ArtworkId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <div class="mb-4">

                    <label asp-for="LanguageCode" class="form-label gallery-form-label">
                    </label>

                    @* Lingua dell'audioguida *@
                    <select asp-for="LanguageCode" class="form-select gallery-form-control">

                        <option value="it-IT">
                            Italiano
                        </option>

                        <option value="en-US">
                            Inglese
                        </option>

                        <option value="fr-FR">
                            Francese
                        </option>

                        <option value="es-ES">
                            Spagnolo
                        </option>

                    </select>

                    <span asp-validation-for="LanguageCode" class="text-danger small">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Title" class="form-label gallery-form-label">
                    </label>

                    @* Titolo *@
                    <input asp-for="Title" class="form-control gallery-form-control" />

                    <span asp-validation-for="Title" class="text-danger small">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="AudioFile" class="form-label gallery-form-label">
                    </label>

                    @* File audio (MP3, M4A o WAV) *@
                    <input asp-for="AudioFile" type="file" accept=".mp3,.m4a,.wav,audio/*" class="form-control gallery-form-control" />

                    <div class="form-text">
                        Formati consentiti:
                        MP3, M4A e WAV.
                        Dimensione massima: 25 MB.
                    </div>

                    <span asp-validation-for="AudioFile" class="text-danger small">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Transcript" class="form-label gallery-form-label">

                        Trascrizione

                    </label>

                    @* Trascrizione del testo *@
                    <textarea asp-for="Transcript" rows="8" class="form-control gallery-form-control" 
                    placeholder="Inserisci la trascrizione dell'audioguida...">
                    </textarea>

                    <div class="form-text">
                        La trascrizione migliora
                        l'accessibilità del contenuto.
                    </div>

                    <span asp-validation-for="Transcript" class="text-danger small">
                    </span>

                </div>

                <div class="form-check mb-5">

                    @* Pubblicata o no *@
                    <input asp-for="IsActive" class="form-check-input" />

                    <label asp-for="IsActive" class="form-check-label">

                        Rendi subito disponibile
                        l'audioguida

                    </label>

                </div>


                <div class="d-flex gap-3 flex-wrap">

                    <button type="submit" class="btn gallery-btn-primary">

                        Salva audioguida

                    </button>

                    <a asp-controller="Artworks" asp-action="Details" asp-route-id="@Model.ArtworkId" class="btn gallery-btn-outline">

                        Annulla

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@* Script per controllare il form prima dell'invio *@
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}