@model BeArtGallery.Models.ArtworkAudioGuide

@{
    ViewData["Title"] = "Elimina audioguida";
}


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="gallery-eyebrow mb-3">
                Gestione audioguida
            </div>

            <h1 class="display-5 mb-4">
                Eliminare l'audioguida?
            </h1>

            <p class="text-muted mb-4">

                Stai per eliminare definitivamente

                <strong>
                    @Model.Title
                </strong>

                associata all'opera

                <strong>
                    @Model.Artwork?.Title
                </strong>.

            </p>


            @* Avviso: verrà cancellato anche il file audio *@
            <div class="alert alert-warning mb-4">

                Verrà eliminato anche il file audio
                salvato sul server.

            </div>


            @* Conferma dell'eliminazione *@
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">

                <div class="d-flex gap-3 flex-wrap">

                    <button type="submit"
                            class="btn gallery-btn-danger">

                        Elimina definitivamente

                    </button>

                    <a asp-controller="Artworks" asp-action="Details" asp-route-id="@Model.ArtworkId" class="btn gallery-btn-outline">

                        Annulla

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>