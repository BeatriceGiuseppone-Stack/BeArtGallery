@model IEnumerable<BeArtGallery.ViewModels.MyArtworkInquiryListItemViewModel>
@using BeArtGallery.Models.Enums

@{
    ViewData["Title"] = "Le mie richieste";
}

<div class="container py-5">

    <div class="gx-band mb-5">

        <div class="gallery-eyebrow mb-3">
            Area personale
        </div>

        <h1 class="artworks-page-title">
            Le mie richieste
        </h1>

        <p class="artworks-page-intro mb-0">
            Consulta le richieste inviate alla galleria
            e continua le conversazioni con il nostro staff.
        </p>

    </div>


    @if (!Model.Any())
    {
        <div class="inquiry-empty-state">

            <h2>
                Non hai ancora inviato richieste
            </h2>

            <p>
                Puoi richiedere informazioni direttamente
                dalla scheda di un'opera.
            </p>

        </div>
    }
    else
    {
        <div class="inquiries-list">

            @foreach (var inquiry in Model)
            {
                <article class="inquiry-list-item">

                    <div class="inquiry-list-main">

                        <div class="d-flex
                                    align-items-center
                                    flex-wrap
                                    gap-3">

                            <h2 class="mb-0">
                                @inquiry.ArtworkTitle
                            </h2>


                            @if (inquiry.ArtworkDeleted)
                            {
                                <span class="gx-unavailable-badge">Opera non più disponibile</span>
                            }


                            @if (inquiry.UnreadReplies > 0)
                            {
                                <span class="inquiry-unread-badge">

                                    @inquiry.UnreadReplies
                                    @(inquiry.UnreadReplies == 1
                                        ? "nuova risposta"
                                        : "nuove risposte")

                                </span>
                            }

                        </div>


                        <div class="inquiry-requester">

                            <div>

                                <span>
                                    Inviata
                                </span>

                                <strong>
                                    @inquiry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Ultima attività
                                </span>

                                <strong>
                                    @inquiry.LastActivity.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Stato
                                </span>

                                @switch (inquiry.Status)
                                {
                                    case ArtworkInquiryStatus.New:
                                        <span class="inquiry-status inquiry-status-new">Nuova</span>
                                        break;

                                    case ArtworkInquiryStatus.InProgress:
                                        <span class="inquiry-status inquiry-status-progress">In lavorazione</span>
                                        break;

                                    case ArtworkInquiryStatus.Closed:
                                        <span class="inquiry-status inquiry-status-closed">Chiusa</span>
                                        break;
                                }

                            </div>

                        </div>

                    </div>


                    <div class="inquiry-list-action">

                        <a asp-action="Details"
                           asp-route-id="@inquiry.Id"
                           class="btn gallery-btn-outline">

                            Apri conversazione

                        </a>

                    </div>

                </article>
            }

        </div>
    }

</div>